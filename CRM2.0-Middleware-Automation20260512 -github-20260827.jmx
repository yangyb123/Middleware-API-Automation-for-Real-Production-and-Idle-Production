    for (String candidate : directCandidates) {
        Map q = symbolInfo(instance,candidate); BigDecimal b=number(value(q,&apos;bid&apos;)), a=number(value(q,&apos;ask&apos;))
        BigDecimal m = formula3Precision &amp;&amp; b!=null &amp;&amp; a!=null &amp;&amp; b&gt;BigDecimal.ZERO &amp;&amp; a&gt;BigDecimal.ZERO ? b.add(a).divide(new BigDecimal(&apos;2&apos;),12,RoundingMode.HALF_UP) : mid5(b,a)
