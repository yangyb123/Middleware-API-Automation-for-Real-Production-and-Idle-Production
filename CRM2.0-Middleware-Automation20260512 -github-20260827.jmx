          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="如果shujuku=1且MT5-查询汇总已平仓仓位数据库" enabled="true">
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;history_pos_shujuku&apos;) == &apos;1&apos; &amp;&amp; vars.get(&apos;history_pos_db_platform&apos;) == &apos;MT5&apos;)}</stringProp>
          </IfController>
          <hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="JDBC Request-查询MT5汇总已平仓仓位-${history_pos_login}" enabled="true">
              <stringProp name="dataSource">mysqlMT5</stringProp>
              <stringProp name="query">SELECT
  mt.*,
  close_sum.Login AS login,
  close_sum.PositionID AS position_ticket,
  close_sum.Symbol AS symbol,
  close_sum.close_deal_ticket AS deal_ticket,
  close_sum.close_order_ticket AS order_ticket,
  open_sum.open_action AS action,
  &apos;mt5&apos; AS source,
  &apos;MT5_1&apos; AS instance_id,
  2 AS account_mode,
  open_sum.open_time_utc_ms AS open_time_utc_ms,
  close_sum.close_time_utc_ms AS close_time_utc_ms,
  open_sum.price_open AS open_price,
  close_sum.price_close AS close_price,
  close_sum.volume_closed / 10000.0 AS volume,
  close_sum.profit AS profit,
  close_sum.swap AS swap,
  close_sum.commission AS commission,
  close_sum.fee AS fee,
  mt.Digits AS digits,
  mt.Comment AS comment,
  close_sum.close_deal_count,
  open_sum.open_deal_count
FROM mt5_deals mt
INNER JOIN (
  SELECT
    d.Login,
    d.PositionID,
    SUBSTRING_INDEX(GROUP_CONCAT(d.Symbol ORDER BY d.TimeMsc DESC), &apos;,&apos;, 1) AS Symbol,
    SUBSTRING_INDEX(GROUP_CONCAT(d.Deal ORDER BY d.TimeMsc DESC), &apos;,&apos;, 1) AS close_deal_ticket,
    SUBSTRING_INDEX(GROUP_CONCAT(d.`Order` ORDER BY d.TimeMsc DESC), &apos;,&apos;, 1) AS close_order_ticket,
    DATE_FORMAT(MAX(d.TimeMsc), &apos;%Y-%m-%d %H:%i:%s&apos;) AS close_time_utc_ms,
    SUM(CASE WHEN d.VolumeClosed &gt; 0 THEN d.VolumeClosed ELSE d.Volume END) AS volume_closed,
    CASE
      WHEN SUM(CASE WHEN d.VolumeClosed &gt; 0 THEN d.VolumeClosed ELSE d.Volume END) &gt; 0
      THEN SUM(d.Price * CASE WHEN d.VolumeClosed &gt; 0 THEN d.VolumeClosed ELSE d.Volume END)
         / SUM(CASE WHEN d.VolumeClosed &gt; 0 THEN d.VolumeClosed ELSE d.Volume END)
      ELSE MAX(d.Price)
    END AS price_close,
    SUM(d.Profit) AS profit,
    SUM(d.Storage) AS swap,
    SUM(d.Commission) AS commission,
    SUM(d.Fee) AS fee,
    COUNT(*) AS close_deal_count
  FROM mt5_deals d
  WHERE d.Login = ?
    AND d.PositionID &gt; 0
    AND d.Entry IN (1, 2, 3)
    AND UNIX_TIMESTAMP(d.TimeMsc) * 1000 &gt;= ?
  GROUP BY d.Login, d.PositionID
) close_sum
  ON close_sum.Login = mt.Login
 AND close_sum.PositionID = mt.PositionID
 AND close_sum.close_deal_ticket = mt.Deal
LEFT JOIN (
  SELECT
    d.Login,
    d.PositionID,
    SUBSTRING_INDEX(GROUP_CONCAT(d.Deal ORDER BY d.TimeMsc ASC), &apos;,&apos;, 1) AS open_deal_ticket,
    SUBSTRING_INDEX(GROUP_CONCAT(d.`Order` ORDER BY d.TimeMsc ASC), &apos;,&apos;, 1) AS open_order_ticket,
    SUBSTRING_INDEX(GROUP_CONCAT(d.Action ORDER BY d.TimeMsc ASC), &apos;,&apos;, 1) AS open_action,
    DATE_FORMAT(MIN(d.TimeMsc), &apos;%Y-%m-%d %H:%i:%s&apos;) AS open_time_utc_ms,
    CASE WHEN SUM(d.Volume) &gt; 0 THEN SUM(d.Price * d.Volume) / SUM(d.Volume) ELSE MIN(d.Price) END AS price_open,
    COUNT(*) AS open_deal_count
  FROM mt5_deals d
  WHERE d.Login = ?
    AND d.PositionID &gt; 0
    AND d.Entry IN (0, 2)
  GROUP BY d.Login, d.PositionID
) open_sum
  ON open_sum.Login = close_sum.Login
 AND open_sum.PositionID = close_sum.PositionID
WHERE mt.Login = ?
ORDER BY close_sum.close_time_utc_ms DESC
LIMIT 50</stringProp>
              <stringProp name="queryArguments">${history_pos_login},${history_pos_close_time_gte},${history_pos_login},${history_pos_login}</stringProp>
              <stringProp name="queryArgumentsTypes">BIGINT,BIGINT,BIGINT,BIGINT</stringProp>
              <stringProp name="queryTimeout">5</stringProp>
              <stringProp name="queryType">Prepared Select Statement</stringProp>
              <stringProp name="resultSetHandler">Store as Object</stringProp>
              <stringProp name="resultSetMaxRows">1000</stringProp>
              <stringProp name="resultVariable">db_history_pos_rows</stringProp>
              <stringProp name="variableNames"></stringProp>
            </JDBCSampler>
