vars.remove(&apos;instance_id&apos;);vars.remove(&apos;symbol&apos;)
if(rows instanceof List&amp;&amp;!rows.isEmpty()&amp;&amp;rows[0] instanceof Map){
    Map first=(Map)rows[0]
    def readIgnoreCase={String wanted-&gt;def e=first.entrySet().find{String.valueOf(it.key).equalsIgnoreCase(wanted)};e?.value}
    String jdbcInstance=String.valueOf(readIgnoreCase(&apos;instance_id&apos;)?:readIgnoreCase(&apos;instanceid&apos;)?:&apos;&apos;).trim()
    String jdbcSymbol=String.valueOf(readIgnoreCase(&apos;symbol&apos;)?:&apos;&apos;).trim()
