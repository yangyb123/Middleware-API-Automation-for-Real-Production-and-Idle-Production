            boolean statusSame=notionalStatus==calcStatus
            String statusEvidence=&apos;calc_source=&apos;+(dbMode?&apos;matched_JDBC_row&apos;:&apos;CSV/API_row&apos;)+&apos;,instance_id=&apos;+(instance?:&apos;&lt;empty&gt;&apos;)+&apos;,login=&apos;+(blank(login)?&apos;&lt;empty&gt;&apos;:idText(login))+&apos;,symbol=&apos;+(symbol?:&apos;&lt;empty&gt;&apos;)+&apos;,volume_lots=&apos;+numText(lots)+&apos;,contract_size=&apos;+numText(contract)+&apos;,open_price=&apos;+numText(open)+&apos;,currency_base=&apos;+(currencyBase?:&apos;&lt;empty&gt;&apos;)+&apos;,currency_profit=&apos;+(profitCurrency?:&apos;&lt;empty&gt;&apos;)+&apos;,usd_rate=&apos;+numText(usdRate)+&apos;,requires_open_price=&apos;+requiresOpenPrice+&apos;,symbol_error=&apos;+String.valueOf(value(info,&apos;__error&apos;) ?: &apos;&lt;none&gt;&apos;)+&apos;,conversion_attempts=&apos;+(conversion.attempts?:&apos;&lt;not-required&gt;&apos;)
            String statusLine=&apos;field=notional_status | API.notional_status=&apos;+(notionalStatus?:&apos;&lt;empty&gt;&apos;)+&apos; | calc_cnotional_status=&apos;+calcStatus+&apos; | &apos;+prefix+&apos; | 判断条件=实例、账户、品种、剩余手数、合约规格、计价币种、USD换算率及公式所需开仓价证据完整才resolved，否则unresolved | 证据=&apos;+statusEvidence
            boolean statusSkip=disabled.contains(&apos;*&apos;)||disabled.contains(norm(&apos;notional_status&apos;))||auxDisabled.contains(&apos;*&apos;)||auxDisabled.contains(norm(&apos;notional_status&apos;))
            if(statusSkip) skipLines &lt;&lt; &apos; - [跳过] | &apos;+statusLine+&apos; | 备注=notional_status已配置跳过&apos;
            else if(statusSame) okLines &lt;&lt; &apos; - [通过] | &apos;+statusLine+&apos; | 备注=API.notional_status与计算状态相等，通过&apos;
            else failLines &lt;&lt; &apos; - [失败] | &apos;+statusLine+&apos; | 备注=API.notional_status与计算状态不相等，失败&apos;
            boolean same=calcStatus==&apos;unresolved&apos;?(apiNotional==null):(apiNotional!=null &amp;&amp; calcNotional!=null &amp;&amp; diff&lt;=finalAllowed)
            String expression=numText(contract)+&apos;*&apos;+numText(lots)+(requiresOpenPrice?&apos;*&apos;+numText(open):&apos;&apos;)+(usdRate==BigDecimal.ONE?&apos;&apos;:&apos;*&apos;+numText(usdRate))+&apos;=&apos;+numText(rawNotional)+&apos;；ROUND_HALF_UP(raw,5)=&apos;+numText(calcNotional)
            String actualPercent=diff!=null &amp;&amp; calcNotional!=null &amp;&amp; calcNotional!=BigDecimal.ZERO?diff.multiply(new BigDecimal(&apos;100&apos;)).divide(calcNotional.abs(),10,RoundingMode.HALF_UP).stripTrailingZeros().toPlainString()+&apos;%&apos;:(diff==BigDecimal.ZERO?&apos;0%&apos;:&apos;N/A&apos;)
            String line=&apos;NOTIONAL_CALC_PRINT_V4 | field=open_notional_value_usd | calc_open_notional_value_usd=&apos;+numText(calcNotional)+&apos; | API_open_notional_value_usd=&apos;+numText(apiNotional)+&apos; | API.notional_status=&apos;+(notionalStatus?:&apos;&lt;empty&gt;&apos;)+&apos; | calc_cnotional_status=&apos;+calcStatus+&apos; | formula_case=&apos;+formulaCase+&apos; | formula=&apos;+formulaTemplate+&apos; | Symbol=&apos;+symbol+&apos; | Base_Currency=&apos;+(currencyBase?:&apos;&lt;empty&gt;&apos;)+&apos; | Quote_Currency=&apos;+profitCurrency+&apos; | Contract_Size=&apos;+numText(contract)+&apos; | Trading_Volume_Lots=&apos;+numText(lots)+&apos; | Open_Price=&apos;+numText(open)+&apos; | Conversion_Symbol=&apos;+(conversion.querySymbol?:&apos;&lt;not-required&gt;&apos;)+&apos; | Conversion_Direction=&apos;+(conversion.direction?:&apos;&lt;not-required&gt;&apos;)+&apos; | Conversion_Attempts=&apos;+(conversion.attempts?:&apos;&lt;not-required&gt;&apos;)+&apos; | Bid=&apos;+numText(conversion.bid)+&apos; | Ask=&apos;+numText(conversion.ask)+&apos; | Exchange_USD=&apos;+numText(usdRate)+&apos; | 计算过程=&apos;+expression+&apos; | 差值=&apos;+(diff==null?&apos;N/A&apos;:numText(diff))+&apos; | 配置百分比误差=&apos;+numText(allowedPercent)+&apos;% | 配置绝对误差=&apos;+numText(allowedAbsolute)+&apos; | 最终允许差值=&apos;+numText(finalAllowed)+&apos; | 实际相差百分比=&apos;+actualPercent+&apos; | &apos;+prefix
            if (same) okLines &lt;&lt; &apos; - [通过] | &apos;+line else failLines &lt;&lt; &apos; - [失败] | &apos;+line
        } catch (Throwable e) {
            failLines &lt;&lt; &apos; - [失败] | 辅助公式open_notional_value_usd计算 | API_open_notional_value_usd=&apos;+numText(apiNotional)+&apos; | calc_open_notional_value_usd=&lt;empty&gt; | &apos;+prefix+&apos; | exception=&apos;+e.class.simpleName+&apos;: &apos;+e.message
        }
    }
}

String status=failLines.isEmpty()?&apos;PASS&apos;:&apos;FAIL&apos;
List&lt;String&gt; report=[]
report &lt;&lt; &apos;Assertion message: 交易大赛-批量查询指定账户的当前未平仓持仓 V1字段/DB或CSV/calc_profit/calc_open_notional_value_usd校验 | status=&apos;+status+&apos; | mode=&apos;+mode+&apos; | case=&apos;+vars.get(&apos;competition_positions_case_index_display&apos;)+&apos;/&apos;+vars.get(&apos;competition_positions_case_total&apos;)+&apos; | CSV行=&apos;+vars.get(&apos;competition_positions_csv_line_no&apos;)+&apos; | shujuku=&apos;+vars.get(&apos;competition_positions_shujuku&apos;)
report &lt;&lt; &apos;接口: POST /v1/positions/query | 文档: mt-hub-openapi 7.html | 版本: MT-Hub API 1.0.1-beta1.60.3&apos;
report &lt;&lt; &apos;已校验data字段(18个): [&apos;+fields.join(&apos;,&apos;)+&apos;]；响应信封字段(4个): [data,errors,next_cursor,as_of_time_ms]&apos;
report &lt;&lt; &apos;响应信封: data=&apos;+apiRows.size()+&apos; | errors=&apos;+errors.size()+&apos; | next_cursor=&apos;+(blank(root.next_cursor)?&apos;&lt;empty&gt;&apos;:root.next_cursor)+&apos; | as_of_time_ms=&apos;+(blank(root.as_of_time_ms)?&apos;&lt;empty&gt;&apos;:root.as_of_time_ms)
if (dbMode) {
    report &lt;&lt; &apos;DB查询平台映射（以instance_id为准）: [&apos;+(vars.get(&apos;competition_positions_db_platform_mappings&apos;) ?: &apos;&lt;empty&gt;&apos;)+&apos;]&apos;
    report &lt;&lt; &apos;CSV platform配置纠正: &apos;+(vars.get(&apos;competition_positions_db_platform_corrections&apos;) ?: &apos;&lt;none&gt;&apos;)+&apos;；instance_id=MT4_*查询mt4_report.MT4_TRADES，instance_id=MT5_*查询mt5_report.mt5_positions。&apos;
}
report &lt;&lt; &apos;DB新增字段校验(5个): [position_lifecycle_id,open_notional_value_usd,notional_status,notional_method,notional_calculation_version]；未配置跳过的字段参与DB/API逐字段比较。&apos;
report &lt;&lt; &apos;DB指定字段跳过配置 competition_positions_db_missing_field_skip_fields=[&apos;+missingSkipRaw+&apos;]；命中后无论DB列缺失或SQL已生成该列，均跳过DB/API值比较；接口必返、类型和语义校验仍执行。&apos;
// 仅增强最终打印：根据row/data.row定位同一条API记录，补充实例、账户、订单、持仓和品种；不改变底层校验结果。
def withAccountContext = { String line -&gt;
    if (!line) return line
    String outputLine = line
        .replace(&apos;API键=[instance:&apos;, &apos;API匹配键(脚本组合，非接口字段)=[instance_id:&apos;)
        .replace(&apos;DB键=[instance:&apos;, &apos;DB匹配键(脚本组合，非接口字段)=[instance_id:&apos;)
        .replace(&apos;, position:&apos;, &apos;, position_id:&apos;)
        .replace(&apos;, order:&apos;, &apos;, order_id:&apos;)
    int apiIndex = -1
    def matcher = outputLine =~ /(?:^|\|\s*)(?:data\.)?row=(\d+)/
    if (matcher.find()) {
        try { apiIndex = Integer.parseInt(matcher.group(1)) - 1 } catch (ignored) { return outputLine }
    } else if (!dbMode &amp;&amp; outputLine.contains(&apos;| CSV=&apos;)) {
        Map csvRow = vars.getObject(&apos;competition_positions_current_csv_row&apos;) instanceof Map ? new LinkedHashMap((Map)vars.getObject(&apos;competition_positions_current_csv_row&apos;)) : [:]
        String wantedPosition = String.valueOf(csvRow.position_id ?: &apos;&apos;).trim()
        String wantedOrder = idText(csvRow.order_id)
        String wantedSymbol = String.valueOf(csvRow.symbol ?: &apos;&apos;).trim()
        List&lt;Integer&gt; matchedIndexes = []
        apiRows.eachWithIndex { Map candidate, int idx -&gt;
            boolean matched
            if (wantedPosition &amp;&amp; wantedPosition != &apos;&lt;empty&gt;&apos;) matched = String.valueOf(candidate.position_id ?: &apos;&apos;) == wantedPosition
            else if (wantedOrder) matched = idText(candidate.order_id) == wantedOrder &amp;&amp; (!wantedSymbol || String.valueOf(candidate.symbol ?: &apos;&apos;) == wantedSymbol)
            else matched = wantedSymbol ? String.valueOf(candidate.symbol ?: &apos;&apos;) == wantedSymbol : true
            if (matched) matchedIndexes &lt;&lt; idx
        }
        if (matchedIndexes.size() == 1) apiIndex = matchedIndexes[0]
    }
    if (apiIndex &lt; 0 || apiIndex &gt;= apiRows.size()) return outputLine
    Map apiRow = apiRows[apiIndex]
    String instanceText = String.valueOf(apiRow.instance_id ?: &apos;&lt;empty&gt;&apos;).trim()
    String loginText = idText(apiRow.login)
    if (!loginText) loginText = &apos;&lt;empty&gt;&apos;
    String orderText = idText(apiRow.order_id)
    if (!orderText) orderText = &apos;&lt;empty&gt;&apos;
    String positionText = String.valueOf(apiRow.position_id ?: &apos;&lt;empty&gt;&apos;).trim()
    String lifecycleText = String.valueOf(apiRow.position_lifecycle_id ?: &apos;&lt;empty&gt;&apos;).trim()
    String symbolText = String.valueOf(apiRow.symbol ?: &apos;&lt;empty&gt;&apos;).trim()
    List&lt;String&gt; contextParts = []
    if (!(outputLine.contains(&apos;instanceid=&apos;) || outputLine.contains(&apos;instance_id=&apos;))) contextParts &lt;&lt; &apos;instanceid=&apos; + instanceText
    if (!outputLine.contains(&apos;login=&apos;)) contextParts &lt;&lt; &apos;login=&apos; + loginText
    if (!outputLine.contains(&apos;order_id=&apos;)) contextParts &lt;&lt; &apos;order_id=&apos; + orderText
    if (!outputLine.contains(&apos;position_id=&apos;)) contextParts &lt;&lt; &apos;position_id=&apos; + positionText
    if (!outputLine.contains(&apos;position_lifecycle_id=&apos;)) contextParts &lt;&lt; &apos;position_lifecycle_id=&apos; + lifecycleText
    if (!outputLine.contains(&apos;symbol=&apos;)) contextParts &lt;&lt; &apos;symbol=&apos; + symbolText
    // OPEN_POSITION_FIELD_FIRST_V1: 将当前对比field移到通过/失败/跳过标记之后，账户、订单、持仓和品种上下文之前。
    String workingLine = outputLine, fieldToken = null
    def fieldMatcher = (workingLine =~ /\s*\|\s*field=([^|]*)/)
    if (fieldMatcher.find()) {
        fieldToken = &apos;field=&apos; + fieldMatcher.group(1).trim()
        String beforeField = workingLine.substring(0, fieldMatcher.start()).replaceFirst(/\s+$/, &apos;&apos;)
        String afterField = workingLine.substring(fieldMatcher.end()).replaceFirst(/^\s*\|\s*/, &apos;&apos;)
        workingLine = beforeField + (afterField ? &apos; | &apos; + afterField : &apos;&apos;)
    }
    List&lt;String&gt; leadingParts = []
    if (fieldToken) leadingParts &lt;&lt; fieldToken
    leadingParts.addAll(contextParts)
    if (!leadingParts) return outputLine
    int firstPipe = workingLine.indexOf(&apos;|&apos;)
    if (firstPipe &lt; 0) return leadingParts.join(&apos; | &apos;) + &apos; | &apos; + workingLine
    String left = workingLine.substring(0, firstPipe).replaceFirst(/\s+$/, &apos;&apos;)
    String right = workingLine.substring(firstPipe + 1).replaceFirst(/^\s+/, &apos;&apos;)
    left + &apos; | &apos; + leadingParts.join(&apos; | &apos;) + (right ? &apos; | &apos; + right : &apos;&apos;)
}
List&lt;String&gt; displayFailLines = failLines.collect { String line -&gt; withAccountContext(line) }
// 只压缩最终成功输出；okLines中的基础校验结果仍由上方逻辑完整产生。
List&lt;String&gt; displayOkLines = okLines.findAll { String line -&gt;
    !((line.contains(&apos;root.field=&apos;) &amp;&amp; line.contains(&apos;备注=必返字段存在&apos;)) ||
      line.contains(&apos;root.field=errors | API=[] | 备注=无账户级部分错误&apos;) ||
      line.contains(&apos;备注=字段存在且类型符合&apos;) ||
      line.contains(&apos;备注=字段键存在且文档允许JSON null&apos;))
}.collect { String line -&gt; withAccountContext(line) }
List&lt;String&gt; displaySkipLines = skipLines.collect { String line -&gt; withAccountContext(line) }
int hiddenBasicPassCount = okLines.size() - displayOkLines.size()
report &lt;&lt; &apos;基础字段成功明细已省略=&apos;+hiddenBasicPassCount+&apos;条；这些字段仍已执行必返、类型、null、枚举及DB/CSV实际值校验，失败始终打印。&apos;
report &lt;&lt; &apos;匹配键说明: SQL按login:symbol:order_id生成DB.position_id（例如5285:GBPUSD:302422）；先按instance_id+login+symbol找候选，再优先按position_id定位，未匹配时回退order_id，再回退唯一账户品种候选。失败诊断打印DB.position_id查询目标、同账户品种候选及全局精确查询结果；取得唯一DB订单后，position_id按trim后的完整文本精确比较。&apos;
report &lt;&lt; &apos;position_id失败归属规则: API.position_id来自接口data，出现position_id匹配失败时不表示API无返回。SQL同时返回DB当前持仓记录和DB原表过滤诊断记录：原表存在目标订单但filter_match=0时，打印CMD/SYMBOL/VOLUME/CLOSE_TIME等过滤原因；原始候选中也不存在时，明确为本次JDBC未查询到该订单，需要检查报表库数据/同步延迟或db_result_max_rows截断。只有DB有当前持仓而API data没有时，才属于API data缺少记录。&apos;
report &lt;&lt; &apos;集合差异规则: DB记录未在API data中匹配时，若存在cursor则按分页跳过；若同一instance_id+login出现在接口errors中，则按账户级错误导致data可能不完整进行跳过，但errors仍独立决定整体状态；只有非分页且账户不在errors中时，才判定API data缺少对应当前持仓并列入失败。&apos;
report &lt;&lt; &apos;notional_status计算规则: 与线程组23一致，DB模式使用已匹配JDBC行的instance_id/login/symbol/volume_lots/open_price，通过get_symbol_ex取得contract_size、profit_mode、currency_base、currency_profit及USD换算证据；证据完整为resolved，否则unresolved，再将calc_cnotional_status与API.notional_status精确比较。普通DB固定投影比较跳过，避免重复或错误判定。&apos;
report &lt;&lt; &apos;辅助计算: enabled=&apos;+auxEnabled+&apos; | fields=[profit,open_notional_value_usd] | max_rows=&apos;+auxMax+&apos; | disabled=[&apos;+auxDisabledRaw+&apos;] | tolerance=[&apos;+auxToleranceRaw+&apos;] | open_notional_value_usd未单独配置时默认5% | 4002重试=&apos;+retryCount+&apos;次/&apos;+retryDelay+&apos;ms&apos;
report &lt;&lt; &apos;名义价值公式: ROUND_HALF_UP(volume_lots*contract_size*open_price*rate_to_USD,5)；按当前剩余持仓量；USD率和结果五位小数HALF_UP；非USD/USC缺少开仓事件时点中间价时只打印跳过诊断，禁止用查询时点当前行情回填。&apos;
report &lt;&lt; &apos;空值规则: API/DB均空通过；API=0且DB空通过；storage均空通过；数据库无字段默认失败，配置后才跳过。&apos;
report &lt;&lt; &apos;统计: 失败=&apos;+failLines.size()+&apos; | 对比/重要通过=&apos;+displayOkLines.size()+&apos; | 基础通过已省略=&apos;+hiddenBasicPassCount+&apos; | 跳过=&apos;+skipLines.size()+&apos; | API记录=&apos;+apiRows.size()
report &lt;&lt; &apos;&apos; &lt;&lt; &apos;【失败明细：&apos;+failLines.size()+&apos;条】&apos;; report.addAll(displayFailLines?:[&apos; - 无&apos;])
report &lt;&lt; &apos;&apos; &lt;&lt; &apos;【对比/重要通过明细：&apos;+displayOkLines.size()+&apos;条】&apos;; report.addAll(displayOkLines?:[&apos; - 无&apos;])
report &lt;&lt; &apos;&apos; &lt;&lt; &apos;【跳过明细：&apos;+skipLines.size()+&apos;条】&apos;; report.addAll(displaySkipLines?:[&apos; - 无&apos;])
report &lt;&lt; &apos;&apos; &lt;&lt; &apos;【接口请求Body】&apos; &lt;&lt; (vars.get(&apos;competition_positions_request_body&apos;) ?: &apos;&apos;)
String finalReport=report.join(&apos;\n&apos;)
publish(finalReport,failLines.isEmpty())</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="TestPlan.comments">按mt-hub-openapi 7.html校验信封及data[]全部18个字段。SQL按login:symbol:order_id生成position_id，同时返回DB当前持仓标记和原表过滤原因；正式比较只使用filter_match=1的当前持仓，filter_match=0只用于诊断原表记录因CMD/SYMBOL/VOLUME/CLOSE_TIME等条件被过滤。API已返回position_id但DB未匹配时，明确归属数据库侧未取得可比较当前持仓，并区分原表无记录和有记录但被过滤；DB有当前持仓但API data无对应记录时，才归属API数据缺失。position_id使用文本精确比较；notional_status从已匹配JDBC行和get_symbol_ex证据推导后与API比较。</stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>
