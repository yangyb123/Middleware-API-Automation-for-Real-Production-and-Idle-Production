          </Arguments>
          <hashTree/>
          <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="汇总的已平仓仓位CSV/API字段对比配置" enabled="true">
            <collectionProp name="Arguments.arguments">
              <elementProp name="history_pos_csv_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">history_pos_csv_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value">action</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </Arguments>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化汇总的已平仓仓位数据库校验变量" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">
String csvName = &apos;汇总的已平仓仓位-数据库校验.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.exists()) {
    throw new AssertionError(&apos;汇总的已平仓仓位CSV文件不存在: &apos; + csvFile.getPath())
}
def dataLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it?.trim() }
if (dataLines.size() &lt;= 1) {
    throw new AssertionError(&apos;汇总的已平仓仓位CSV没有数据行: &apos; + csvFile.getPath())
}

String shujuku = (vars.get(&apos;shujuku&apos;) ?: &apos;&apos;).trim()
String instanceId = (vars.get(&apos;order_instanceid_val&apos;) ?: vars.get(&apos;instanceid_val&apos;) ?: vars.get(&apos;instance_id&apos;) ?: &apos;&apos;).trim()
String login = (vars.get(&apos;order_login&apos;) ?: vars.get(&apos;login&apos;) ?: &apos;&apos;).trim()
String closeGte = &apos;1778379836000&apos;

if (!(shujuku in [&apos;0&apos;, &apos;1&apos;])) throw new AssertionError(&apos;汇总的已平仓仓位 shujuku只能是0或1，当前=&apos; + shujuku)
if (!instanceId) throw new AssertionError(&apos;汇总的已平仓仓位 order_instanceid_val不能为空&apos;)
if (!login) throw new AssertionError(&apos;汇总的已平仓仓位 order_login/login不能为空&apos;)
String platform = instanceId.toUpperCase().contains(&apos;MT5&apos;) ? &apos;MT5&apos; : (instanceId.toUpperCase().contains(&apos;MT4&apos;) ? &apos;MT4&apos; : &apos;&apos;)
if (!platform) throw new AssertionError(&apos;汇总的已平仓仓位 order_instanceid_val只支持MT4_*/MT5_*，当前=&apos; + instanceId)

vars.put(&apos;history_pos_shujuku&apos;, shujuku)
vars.put(&apos;history_pos_login&apos;, login)
vars.put(&apos;history_pos_instanceid&apos;, instanceId)
vars.put(&apos;history_pos_db_platform&apos;, platform)
vars.put(&apos;history_pos_close_time_gte&apos;, closeGte)
vars.put(&apos;instanceid&apos;, instanceId)
vars.put(&apos;login&apos;, login)
vars.putObject(&apos;db_history_pos_rows&apos;, [])
