          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="17-2执行前置配置检查-跨机器诊断" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def required = [&apos;middlewareip&apos;,&apos;port&apos;,&apos;login&apos;,&apos;instanceid&apos;,&apos;profit_trade_api_host&apos;,&apos;profit_trade_api_port&apos;,&apos;profit_trade_account&apos;,&apos;profit_trade_password&apos;,&apos;profit_trade_broker_ip&apos;,&apos;profit_trade_symbol&apos;,&apos;profit_trade_volume&apos;]
def invalid = required.findAll { String name -&gt;
    String value = (vars.get(name) ?: &apos;&apos;).trim()
    !value || value ==~ /\$\{.+\}/
}
if (invalid) throw new AssertionError(&apos;17-2前置配置缺失或未解析: &apos; + invalid.join(&apos;, &apos;) + &apos;；服务器运行请通过 -Jprofit_check_* 参数覆盖环境值&apos;)
if (!((vars.get(&apos;login&apos;) ?: &apos;&apos;) ==~ /\d+/)) throw new AssertionError(&apos;profit_check_login必须是整数，当前=&apos; + vars.get(&apos;login&apos;))
if (!((vars.get(&apos;profit_trade_volume&apos;) ?: &apos;&apos;) ==~ /\d+(?:\.\d+)?/)) throw new AssertionError(&apos;profit_check_volume必须是正数，当前=&apos; + vars.get(&apos;profit_trade_volume&apos;))
String diagnostic = &apos;17-2前置配置检查通过 | JMeterBaseDir=&apos; + org.apache.jmeter.services.FileServer.getFileServer().getBaseDir() + &apos; | user.dir=&apos; + System.getProperty(&apos;user.dir&apos;) + &apos; | middleware=&apos; + vars.get(&apos;middlewareip&apos;) + &apos;:&apos; + vars.get(&apos;port&apos;) + &apos; | tradeApi=&apos; + vars.get(&apos;profit_trade_api_host&apos;) + &apos;:&apos; + vars.get(&apos;profit_trade_api_port&apos;) + &apos; | instanceid=&apos; + vars.get(&apos;instanceid&apos;) + &apos; | login=&apos; + vars.get(&apos;login&apos;) + &apos; | symbol=&apos; + vars.get(&apos;profit_trade_symbol&apos;) + &apos; | password=已配置(不打印)&apos;
SampleResult.setSuccessful(true); SampleResult.setResponseCode(&apos;200&apos;); SampleResult.setResponseMessage(&apos;READY&apos;); SampleResult.setResponseData(diagnostic, &apos;UTF-8&apos;); log.info(diagnostic)</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223Sampler>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化本次盈亏校验时间窗口-北京时间偏移177分钟" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">long offsetMinutes = Long.parseLong((vars.get(&apos;profit_time_offset_minutes&apos;) ?: &apos;177&apos;).trim())
long windowMinutes = Long.parseLong((vars.get(&apos;profit_history_window_minutes&apos;) ?: &apos;60&apos;).trim())
if (windowMinutes &lt;= 0L) throw new AssertionError(&apos;profit_check_history_window_minutes必须大于0&apos;)
long startMs = System.currentTimeMillis()
long closeFromMs = startMs + offsetMinutes * 60L * 1000L
long closeToMs = closeFromMs + windowMinutes * 60L * 1000L
vars.put(&apos;profit_check_start_utc_ms&apos;, String.valueOf(startMs))
vars.put(&apos;close_time_from_utc_ms&apos;, String.valueOf(closeFromMs))
vars.put(&apos;close_time_to_utc_ms&apos;, String.valueOf(closeToMs))
SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&apos;200&apos;)
SampleResult.setResponseMessage(&apos;OK&apos;)
SampleResult.setResponseData(&apos;close_time_from_utc_ms=&apos; + closeFromMs + &apos;, close_time_to_utc_ms=&apos; + closeToMs + &apos;, offsetMinutes=&apos; + offsetMinutes + &apos;, windowMinutes=&apos; + windowMinutes, &apos;UTF-8&apos;)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223Sampler>
