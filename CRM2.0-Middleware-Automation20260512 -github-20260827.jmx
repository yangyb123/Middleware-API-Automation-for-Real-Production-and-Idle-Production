def mid5 = { BigDecimal bid, BigDecimal ask -&gt; bid != null &amp;&amp; ask != null &amp;&amp; bid &gt; BigDecimal.ZERO &amp;&amp; ask &gt; BigDecimal.ZERO ? bid.add(ask).divide(new BigDecimal(&apos;2&apos;),10,RoundingMode.HALF_UP).setScale(5,RoundingMode.HALF_UP) : null }
def notionalUsdConversion = { String instance, String sourceSymbol, String quoteCurrency, boolean formula3Precision -&gt;
    String ccy = String.valueOf(quoteCurrency ?: &apos;&apos;).trim().toUpperCase()
    String upper = sourceSymbol.toUpperCase(), suffix = sourceSymbol.size() &gt; 6 ? sourceSymbol.substring(6) : &apos;&apos;
    List&lt;String&gt; directCandidates = [ccy+&apos;USD&apos;+suffix, ccy+&apos;USD&apos;].unique(), reverseCandidates = [&apos;USD&apos;+ccy+suffix, &apos;USD&apos;+ccy].unique()
