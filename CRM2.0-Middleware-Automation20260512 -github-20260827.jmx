            <stringProp name="variableNames">shujuku,order_instanceid_val,order_login,close_time_utc_ms__gte,symbol,position_ticket,swap,fee,open_time_utc_ms,deal_ticket,source,login,volume,order_ticket,close_price,close_time_utc_ms,instance_id,action,commission,digits,open_price,profit,account_mode</stringProp>
          </CSVDataSet>
