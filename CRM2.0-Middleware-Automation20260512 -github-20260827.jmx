            <stringProp name="script">// 专属计数器：loop_count_Loop1
int count = vars.get(&quot;loop_count_Loop1&quot;) == null ? 0 : Integer.parseInt(vars.get(&quot;loop_count_Loop1&quot;));

if (count == 0) {
    vars.put(&quot;login_val&quot;, vars.get(&quot;production account51&quot;));
    vars.put(&quot;instanceid_val&quot;, vars.get(&quot;mt5instanceid&quot;));
} else {
    vars.put(&quot;login_val&quot;, vars.get(&quot;production account41&quot;));
    vars.put(&quot;instanceid_val&quot;, vars.get(&quot;mt4instanceid&quot;));
}

vars.put(&quot;loop_count_Loop1&quot;, String.valueOf(count + 1));</stringProp>
