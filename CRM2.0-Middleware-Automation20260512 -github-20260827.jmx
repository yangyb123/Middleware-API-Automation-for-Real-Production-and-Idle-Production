            else if (profitCurrency) { formulaCase=&apos;5-非外汇计价货币非USD&apos;; formulaTemplate=&apos;ContractSize*Lots*OpenPrice*QuoteUSD_MidPrice&apos;; conversion=notionalUsdConversion(instance,symbol,profitCurrency,false); usdRate=number(conversion.rate); requiresOpenPrice=true }
            else { formulaCase=&apos;5-非外汇计价货币未知&apos;; formulaTemplate=&apos;ContractSize*Lots*OpenPrice*QuoteUSD_MidPrice&apos;; conversion=[rate:null,querySymbol:&apos;&lt;unknown&gt;&apos;,direction:&apos;&lt;unresolved&gt;&apos;,attempts:&apos;currency_profit为空，未查询转换品种&apos;]; usdRate=null; requiresOpenPrice=true }
            boolean evidenceComplete = !blank(instance) &amp;&amp; !blank(login) &amp;&amp; !blank(symbol) &amp;&amp; contract!=null &amp;&amp; contract&gt;BigDecimal.ZERO &amp;&amp; lots!=null &amp;&amp; lots&gt;BigDecimal.ZERO &amp;&amp; usdRate!=null &amp;&amp; usdRate&gt;BigDecimal.ZERO &amp;&amp; (!requiresOpenPrice || (open!=null &amp;&amp; open&gt;BigDecimal.ZERO))
