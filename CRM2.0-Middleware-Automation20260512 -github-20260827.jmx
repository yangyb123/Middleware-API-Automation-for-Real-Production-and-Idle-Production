    String.valueOf(csvManualCompareRaw).split(/[,;\r\n]+/).each{String configuredField-&gt;String fieldName=String.valueOf(configuredField?:&apos;&apos;).trim();if(fieldName&amp;&amp;!csvCompareFields.any{norm(it)==norm(fieldName)})csvCompareFields&lt;&lt;fieldName}
    Map csvRow=vars.getObject(&apos;competition_history_current_csv_row&apos;) instanceof Map?new LinkedHashMap((Map)vars.getObject(&apos;competition_history_current_csv_row&apos;)):[:]
    String expectedInstance=String.valueOf(csvRow.instance_id?:csvRow.instanceid?:&apos;&apos;).trim();String expectedLogin=idText(csvRow.login)
    String wantedLifecycle=String.valueOf(csvRow.position_lifecycle_id?:&apos;&apos;).trim(),wantedPosition=String.valueOf(csvRow.position_id?:&apos;&apos;).trim(),wantedOrder=idText(csvRow.order_id),wantedSymbol=String.valueOf(csvRow.symbol?:&apos;&apos;).trim()
    List&lt;Map&gt; candidates=apiRows.findAll{Map r-&gt;if(String.valueOf(r.instance_id?:&apos;&apos;)!=expectedInstance||idText(r.login)!=expectedLogin)return false;if(wantedLifecycle)return String.valueOf(r.position_lifecycle_id?:&apos;&apos;)==wantedLifecycle;if(wantedPosition)return String.valueOf(r.position_id?:&apos;&apos;)==wantedPosition;if(wantedOrder)return idText(r.order_id)==wantedOrder;wantedSymbol?String.valueOf(r.symbol?:&apos;&apos;)==wantedSymbol:true}
    if(candidates.size()!=1)failLines&lt;&lt;&apos; - [失败] | CSV行=&apos;+vars.get(&apos;competition_history_csv_line_no&apos;)+&apos; | account=&apos;+expectedInstance+&apos;|&apos;+expectedLogin+&apos; | lifecycle=&apos;+(wantedLifecycle?:&apos;&lt;empty&gt;&apos;)+&apos; | position=&apos;+(wantedPosition?:&apos;&lt;empty&gt;&apos;)+&apos; | 原因=接口匹配记录应为1条，实际=&apos;+candidates.size()
    else{Map apiRow=candidates[0];reportCsvApiRow=apiRow;csvCompareFields.each{String f-&gt;
        Map a=lookup(apiRow,f);Object rawObj;boolean has=true
        if(f==&apos;instance_id&apos;)rawObj=csvRow.instance_id?:csvRow.instanceid
        else if(f==&apos;login&apos;)rawObj=csvRow.login
        else if(f==&apos;platform&apos;){String p=String.valueOf(csvRow.platform?:&apos;&apos;).trim().toLowerCase();rawObj=p?:(expectedInstance.toUpperCase().contains(&apos;MT4&apos;)?&apos;mt4&apos;:expectedInstance.toUpperCase().contains(&apos;MT5&apos;)?&apos;mt5&apos;:&apos;&apos;)}
        else if(csvRow.containsKey(f))rawObj=csvRow[f]
        else has=false
        String raw=rawObj==null?&apos;&apos;:String.valueOf(rawObj).trim()
        if(disabled.contains(&apos;*&apos;)||disabled.contains(norm(f))){skipLines&lt;&lt;&apos; - [跳过] | field=&apos;+f+&apos; | API=&apos;+(a.exists?numText(a.value):&apos;&lt;field-missing&gt;&apos;)+&apos; | CSV=&apos;+(raw?:&apos;&lt;empty&gt;&apos;)+&apos; | 备注=CSV/API跳过配置&apos;;return}
        if(!has){failLines&lt;&lt;&apos; - [失败] | field=&apos;+f+&apos; | 原因=CSV表头缺少V1字段&apos;;return}
        if(!raw){skipLines&lt;&lt;&apos; - [跳过] | field=&apos;+f+&apos; | API=&apos;+(a.exists?numText(a.value):&apos;&lt;field-missing&gt;&apos;)+&apos; | CSV=&lt;empty&gt; | 备注=未填写期望值；字段结构和类型仍已校验，断言空值请填写&lt;empty&gt;&apos;;return}
        if(!a.exists){failLines&lt;&lt;&apos; - [失败] | field=&apos;+f+&apos; | API=&lt;field-missing&gt; | CSV=&apos;+raw;return}
        Object expected=raw in [&apos;&lt;empty&gt;&apos;,&apos;&lt;null&gt;&apos;]?null:raw;Map cr=compare(f,a.value,expected,&apos;CSV&apos;,percentMap,defaultPercent,absoluteMap,defaultAbsolute)
        String line=&apos;field=&apos;+f+&apos; | API=&apos;+cr.api+&apos; | CSV=&apos;+cr.expected+&apos; | 差值=&apos;+cr.diff+&apos; | 相差百分比=&apos;+cr.percent+&apos; | 计算过程=&apos;+cr.formula+&apos; | 备注=&apos;+cr.note
        if(cr.same)okLines&lt;&lt;&apos; - [通过] | &apos;+line else failLines&lt;&lt;&apos; - [失败] | &apos;+line
    }}
}

// HISTORY_TRADE_CONTEXT_V1: 为每条可定位的字段明细统一补充账户、订单、持仓及生命周期上下文，不改变原有比对结果。
def reportValue={Object v,boolean integerId-&gt;String text=integerId?idText(v):(blank(v)?&apos;&apos;:String.valueOf(v).trim());text?:&apos;&lt;empty&gt;&apos;}
def withHistoryTradeContext={String line-&gt;
    if(!line)return line
    if(line.contains(&apos;NOTIONAL_CALC_PRINT_V3&apos;)||line.contains(&apos;NOTIONAL_CALC_PRINT_V4&apos;))return line.replace(&apos;NOTIONAL_CALC_PRINT_V3 | &apos;,&apos;&apos;).replace(&apos;NOTIONAL_CALC_PRINT_V4 | &apos;,&apos;&apos;)
    Map apiRow=null
    Integer apiRowNo=null
    def rowMatcher=(line=~/((?:^|\|\s*)data\.row=(\d+))/)
    if(rowMatcher.find()){apiRowNo=Integer.parseInt(rowMatcher.group(2));if(apiRowNo&gt;0&amp;&amp;apiRowNo&lt;=apiRows.size())apiRow=apiRows[apiRowNo-1]}
    if(apiRow==null&amp;&amp;!dbMode&amp;&amp;reportCsvApiRow&amp;&amp;line.contains(&apos; | field=&apos;)&amp;&amp;!line.contains(&apos;errors.row=&apos;)&amp;&amp;!line.contains(&apos;envelope.field=&apos;))apiRow=reportCsvApiRow
    if(!(apiRow instanceof Map))return line
    String context=&apos;instanceid=&apos;+reportValue(apiRow.instance_id,false)+&apos; | login=&apos;+reportValue(apiRow.login,true)+&apos; | order_id=&apos;+reportValue(apiRow.order_id,true)+&apos; | position_id=&apos;+reportValue(apiRow.position_id,false)+&apos; | position_lifecycle_id=&apos;+reportValue(apiRow.position_lifecycle_id,false)+&apos; | symbol=&apos;+reportValue(apiRow.symbol,false)
    // HISTORY_FIELD_API_DB_FIRST_V2: 固定输出field | API | DB，再追加订单和生命周期上下文。
    String workingLine=line,fieldToken=null,fieldName=null
    def fieldMatcher=(workingLine=~/\s*\|\s*field=([^|]*)/)
    if(fieldMatcher.find()){
        fieldName=fieldMatcher.group(1).trim();fieldToken=&apos;field=&apos;+fieldName
        String beforeField=workingLine.substring(0,fieldMatcher.start()).replaceFirst(/\s+$/,&apos;&apos;)
        String afterField=workingLine.substring(fieldMatcher.end()).replaceFirst(/^\s*\|\s*/,&apos;&apos;)
        workingLine=beforeField+(afterField?&apos; | &apos;+afterField:&apos;&apos;)
    }
    List&lt;String&gt; comparisonTokens=[]
    [&apos;API&apos;,&apos;DB&apos;].each{String label-&gt;
        def valueMatcher=(workingLine=~/\s*\|\s*${label}=([^|]*)/)
        if(valueMatcher.find()){
            comparisonTokens&lt;&lt;label+&apos;=&apos;+valueMatcher.group(1).trim()
            String beforeValue=workingLine.substring(0,valueMatcher.start()).replaceFirst(/\s+$/,&apos;&apos;)
            String afterValue=workingLine.substring(valueMatcher.end()).replaceFirst(/^\s*\|\s*/,&apos;&apos;)
            workingLine=beforeValue+(afterValue?&apos; | &apos;+afterValue:&apos;&apos;)
        }
    }
    // HISTORY_PREVALIDATION_DB_VALUE_V3：DB值只允许来自相同login+order_id的唯一记录，不打印其他订单候选值。
    if(dbMode&amp;&amp;fieldName&amp;&amp;apiRowNo!=null&amp;&amp;!comparisonTokens.any{it.startsWith(&apos;DB=&apos;)}){
        List&lt;Map&gt; dbValueRows=matchedDbByApiRow[apiRowNo] instanceof Map?[(Map)matchedDbByApiRow[apiRowNo]]:(diagnosticDbByApiRow[apiRowNo]?:[])
        if(dbValueRows.size()==1){
            List&lt;String&gt; dbValues=dbValueRows.collect{Map candidate-&gt;Map dbField=lookup(candidate,fieldName);dbField.exists?numText(dbField.value):&apos;&lt;field-missing&gt;&apos;}.unique()
            comparisonTokens&lt;&lt;&apos;DB=&apos;+dbValues[0]
        }else if(dbValueRows.size()&gt;1)comparisonTokens&lt;&lt;&apos;DB=&lt;duplicate-login-order:&apos;+dbValueRows.size()+&apos; rows&gt;&apos;
        else comparisonTokens&lt;&lt;&apos;DB=&lt;no-login-order-match&gt;&apos;
    }
    String leading=(([fieldToken]+comparisonTokens+[context]).findAll{it}.join(&apos; | &apos;))
    int firstPipe=workingLine.indexOf(&apos;|&apos;)
    if(firstPipe&lt;0)return leading+&apos; | &apos;+workingLine
    String left=workingLine.substring(0,firstPipe).replaceFirst(/\s+$/,&apos;&apos;)
    String right=workingLine.substring(firstPipe+1).replaceFirst(/^\s+/,&apos;&apos;)
    left+&apos; | &apos;+leading+(right?&apos; | &apos;+right:&apos;&apos;)
}
List&lt;String&gt; displayFailLines=failLines.collect{withHistoryTradeContext(it)}
List&lt;String&gt; displayOkLines=okLines.collect{withHistoryTradeContext(it)}
List&lt;String&gt; displaySkipLines=skipLines.collect{withHistoryTradeContext(it)}
String status=failLines.isEmpty()?&apos;PASS&apos;:&apos;FAIL&apos;;List&lt;String&gt; report=[]
report&lt;&lt;&apos;Assertion message: 交易大赛-批量查询完全关闭持仓生命周期 V1响应每字段/DB或CSV校验 | status=&apos;+status+&apos; | mode=&apos;+mode+&apos; | case=&apos;+vars.get(&apos;competition_history_case_index_display&apos;)+&apos;/&apos;+vars.get(&apos;competition_history_case_total&apos;)+&apos; | CSV行=&apos;+vars.get(&apos;competition_history_csv_line_no&apos;)+&apos; | shujuku=&apos;+vars.get(&apos;competition_history_shujuku&apos;)
report&lt;&lt;&apos;接口: POST /v1/positions/history/query | 文档: mt-hub-openapi 7.html | 版本: MT-Hub API 1.0.1-beta1.60.3&apos;
report&lt;&lt;&apos;已校验响应字段: envelope=[&apos;+envelopeFields.join(&apos;,&apos;)+&apos;] | data[]=[&apos;+fields.join(&apos;,&apos;)+&apos;] | errors[]=[&apos;+allowedErrorFields.join(&apos;,&apos;)+&apos;]&apos;
report&lt;&lt;&apos;响应信封: data=&apos;+apiRows.size()+&apos; | errors=&apos;+errors.size()+&apos; | next_cursor=&apos;+(blank(root.next_cursor)?&apos;&lt;empty&gt;&apos;:root.next_cursor)+&apos; | as_of_time_ms=&apos;+numText(root.as_of_time_ms)
report&lt;&lt;&apos;请求close_time范围=[&apos;+fromMs+&apos;,&apos;+toMs+&apos;]；数据库缺失字段跳过配置=[&apos;+missingSkipRaw+&apos;]；字段不存在与字段值为空严格区分&apos;
report&lt;&lt;&apos;DB聚合说明: 依据mt4_report.sql/mt5_report.sql；MT4按已关闭交易且排除epoch未平仓哨兵；MT5按Login/PositionID/Symbol聚合开平Deal，平仓有效手数优先使用VolumeClosedExt/VolumeClosed，并排除mt5_positions中仍存在的当前持仓。&apos;
report&lt;&lt;&apos;notional_status独立判断: 按《订单名义价值计算公式.v1.md》5分支选择路径；公式3按Quote Currency查找USD转换品种；合约规格、币种、开平仓价格和所需Bid/Ask完整时resolved，否则unresolved。&apos;
report&lt;&lt;&apos;名义价值独立计算: 公式3=ContractSize*Lots*Open/ClosePrice*ExchangeUSD；USD在后ExchangeUSD=(Bid+Ask)/2，USD在前ExchangeUSD=2/(Bid+Ask)；开仓、平仓分别计算，calc_bilateral_notional_value_usd=开仓+平仓；最终名义价值保留5位HALF_UP。其他4类公式保持原逻辑。&apos;
report&lt;&lt;&apos;报价口径警示: get_symbol_ex是调用时当前Bid/Ask，不是开/平仓历史时点报价；明细以quote_source=get_symbol_ex_current_quote标识。&apos;
report&lt;&lt;&apos;DB未匹配行策略: policy=&apos;+unmatchedDbPolicy+&apos; | unmatched_db_rows=&apos;+unmatchedDbCount+&apos;；无论策略为何，API记录找不到唯一DB行或任一可比字段不一致都判失败。&apos;
report&lt;&lt;&apos;数值误差配置: percent=[&apos;+percentRaw+&apos;] | absolute=[&apos;+absoluteRaw+&apos;]&apos;
report&lt;&lt;&apos;空值规则: API/DB均空通过；API=0且DB空通过；storage均空通过；数据库无字段默认失败，只有配置后才跳过。&apos;
report&lt;&lt;&apos;DB/API关联规则: 优先按instance_id+login+position_id唯一匹配；其次按instance_id+login+order_id唯一匹配（MT5同一order_id多Position时用position_id消歧）；仍未命中但同instance_id+login+symbol+close_time_ms只有一个候选时继续逐字段对比并暴露身份字段差异。字段明细固定打印field、API、DB。&apos;
report&lt;&lt;&apos;DB占位值说明: DB=&lt;no-login-order-match&gt;表示该API行没有找到唯一DB关联行，因此DB值未知，并不表示DB字段值为空或订单手数为0；DB=&lt;duplicate-login-order:N rows&gt;表示仍有N条候选且无法唯一选择。&apos;
report&lt;&lt;&apos;稳定排序说明: 历史持仓先按close_time_ms DESC；平仓时间相同才依次按instance_id ASC、login数值ASC、position_lifecycle_id ASC。日志会分别打印相同时间、前一行和当前行三个排序字段；必返排序字段为空时只报告字段错误，避免重复排序失败。&apos;
report&lt;&lt;&apos;统计: 失败=&apos;+failLines.size()+&apos; | 通过=&apos;+okLines.size()+&apos; | 跳过=&apos;+skipLines.size()+&apos; | API记录=&apos;+apiRows.size()+&apos; | DB模式=&apos;+dbMode
report&lt;&lt;&apos;&apos;&lt;&lt;&apos;【失败明细：&apos;+failLines.size()+&apos;条】&apos;;report.addAll(displayFailLines?:[&apos; - 无&apos;])
report&lt;&lt;&apos;&apos;&lt;&lt;&apos;【通过明细：&apos;+okLines.size()+&apos;条】&apos;;report.addAll(displayOkLines?:[&apos; - 无&apos;])
report&lt;&lt;&apos;&apos;&lt;&lt;&apos;【跳过明细：&apos;+skipLines.size()+&apos;条】&apos;;report.addAll(displaySkipLines?:[&apos; - 无&apos;])
report&lt;&lt;&apos;&apos;&lt;&lt;&apos;【接口请求Body】&apos;&lt;&lt;(vars.get(&apos;competition_history_request_body&apos;)?:&apos;&apos;)
String finalReport=report.join(&apos;\n&apos;);publish(finalReport,failLines.isEmpty())</stringProp>
