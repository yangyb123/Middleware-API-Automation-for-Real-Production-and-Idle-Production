            <collectionProp name="Arguments.arguments">
              <elementProp name="acct_metrics_csv_disabled_compare_fields" elementType="Argument">
                <stringProp name="Argument.name">acct_metrics_csv_disabled_compare_fields</stringProp>
                <stringProp name="Argument.value">degrade_reason,margin_free,margin_level,metrics_degraded,metrics_updated_utc_ms,profit,currency,margin,position_count,balance,equity,metrics_stale</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">只控制CSV/API对比的跳过字段，多个字段用逗号分隔；例如填写 volume_current 后CSV/API不校验该字段。</stringProp>
              </elementProp>
              <elementProp name="acct_metrics_csv_api_field_tolerance_percent" elementType="Argument">
                <stringProp name="Argument.name">acct_metrics_csv_api_field_tolerance_percent</stringProp>
                <stringProp name="Argument.value">margin_level=2</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <stringProp name="Argument.desc">CSV/API字段误差配置；支持 field=20、field:20、field 20、field=20%；多个字段用逗号/分号/换行分隔；以CSV为基准计算差值百分比，误差小于等于配置值通过；未配置字段默认0%，只有手工配置的字段才允许对应误差。</stringProp>
              </elementProp>
            </collectionProp>
            <stringProp name="TestPlan.comments">equity</stringProp>
          </Arguments>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="初始化账户级财务指标数据库校验变量" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
