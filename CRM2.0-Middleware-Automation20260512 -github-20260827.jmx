              <stringProp name="script">import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import org.apache.jmeter.samplers.SampleResult
import java.math.BigDecimal
import java.math.RoundingMode

String responseText = prev.getResponseDataAsString()
List&lt;String&gt; okLines = []
List&lt;String&gt; failLines = []
List&lt;String&gt; skipLines = []

def publish = { String text, boolean success -&gt;
    vars.put(&apos;competition_positions_compare_report&apos;, text ?: &apos;&apos;)
    vars.put(&apos;competition_positions_compare_status&apos;, success ? &apos;PASS&apos; : &apos;FAIL&apos;)
    log.info(&apos;\n&apos; + text)
    def detail = new SampleResult()
    detail.setSampleLabel(&apos;交易大赛V1当前未平仓持仓字段与calc_profit校验结果&apos;)
    detail.setSuccessful(success)
    detail.setResponseCode(success ? &apos;200&apos; : &apos;500&apos;)
    detail.setResponseMessage(success ? &apos;PASS&apos; : &apos;FAIL&apos;)
    detail.setResponseData(text ?: &apos;&apos;, &apos;UTF-8&apos;)
    detail.setDataType(SampleResult.TEXT)
    detail.setContentType(&apos;text/plain; charset=UTF-8&apos;)
    detail.setResponseHeaders(&apos;Content-Type: text/plain; charset=UTF-8&apos;)
    long detailTime = System.currentTimeMillis()
    detail.setStartTime(detailTime)
    detail.setEndTime(detailTime)
    prev.addSubResult(detail)
    AssertionResult.setFailure(!success)
    AssertionResult.setFailureMessage(success ? &apos;&apos; : text)
}

def blank = { Object v -&gt; v == null || (v instanceof CharSequence &amp;&amp; String.valueOf(v).trim().isEmpty()) }
def number = { Object v -&gt;
    if (v == null || v instanceof Boolean) return null
    try { new BigDecimal(String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;)) } catch (ignored) { null }
}
def numText = { Object v -&gt;
    BigDecimal n = number(v)
    if (n == null) return blank(v) ? &apos;&lt;empty&gt;&apos; : String.valueOf(v)
    BigDecimal x = n.stripTrailingZeros()
    x.scale() &lt; 0 ? x.setScale(0).toPlainString() : x.toPlainString()
}
def idText = { Object v -&gt;
    BigDecimal n = number(v)
    if (n != null &amp;&amp; n.stripTrailingZeros().scale() &lt;= 0) return n.toBigInteger().toString()
    blank(v) ? &apos;&apos; : String.valueOf(v).trim()
}
def norm = { Object v -&gt; String.valueOf(v ?: &apos;&apos;).trim().toLowerCase().replaceAll(/[^a-z0-9]/, &apos;&apos;) }
def setOf = { String raw -&gt;
    Set&lt;String&gt; out = new LinkedHashSet&lt;String&gt;()
    String.valueOf(raw ?: &apos;&apos;).split(/[,;\r\n]+/).each { String x -&gt; if (x.trim()) out &lt;&lt; norm(x) }
    out
}
def toleranceOf = { String raw -&gt;
    Map&lt;String,BigDecimal&gt; out = new LinkedHashMap&lt;String,BigDecimal&gt;()
    String.valueOf(raw ?: &apos;&apos;).split(/[,;\r\n]+/).each { String token -&gt;
        int p = token.indexOf(&apos;=&apos;)
        BigDecimal n = p &gt; 0 ? number(token.substring(p + 1)) : null
        if (p &gt; 0 &amp;&amp; n != null &amp;&amp; n &gt;= BigDecimal.ZERO) out[norm(token.substring(0, p))] = n
    }
    out
}
def intVar = { String name, int defaultValue, int min, int max -&gt;
    try { Math.max(min, Math.min(max, Integer.parseInt(vars.get(name) ?: String.valueOf(defaultValue)))) } catch (ignored) { defaultValue }
}
def boolVar = { String name, boolean defaultValue -&gt;
    String raw = vars.get(name)
    raw == null || !raw.trim() ? defaultValue : raw.trim().toLowerCase() in [&apos;1&apos;, &apos;true&apos;, &apos;yes&apos;, &apos;on&apos;]
}

Map&lt;String,List&lt;String&gt;&gt; aliases = [
    instance_id: [&apos;instance_id&apos;, &apos;instanceid&apos;], platform: [&apos;platform&apos;, &apos;source&apos;],
    position_id: [&apos;position_id&apos;], position_lifecycle_id: [&apos;position_lifecycle_id&apos;],
    order_id: [&apos;order_id&apos;, &apos;order_ticket&apos;, &apos;position_ticket&apos;, &apos;position&apos;], login: [&apos;login&apos;],
    side: [&apos;side&apos;], symbol: [&apos;symbol&apos;], symbol_id: [&apos;symbol_id&apos;],
    volume_lots: [&apos;volume_lots&apos;, &apos;volume&apos;], open_price: [&apos;open_price&apos;, &apos;price_open&apos;, &apos;priceopen&apos;],
    open_time_ms: [&apos;open_time_ms&apos;, &apos;open_time_utc_ms&apos;, &apos;timecreatemsc&apos;], profit: [&apos;profit&apos;],
    account_currency: [&apos;account_currency&apos;, &apos;currency&apos;], open_notional_value_usd: [&apos;open_notional_value_usd&apos;],
    notional_status: [&apos;notional_status&apos;], notional_method: [&apos;notional_method&apos;],
    notional_calculation_version: [&apos;notional_calculation_version&apos;], storage: [&apos;storage&apos;, &apos;swap&apos;],
    currency: [&apos;currency&apos;], currency_profit: [&apos;currency_profit&apos;], currency_base: [&apos;currency_base&apos;],
    contract_size: [&apos;contract_size&apos;], bid: [&apos;bid&apos;], ask: [&apos;ask&apos;], __error: [&apos;__error&apos;], __query_symbol: [&apos;__query_symbol&apos;]
]
def lookup = { Map row, String field -&gt;
    if (!(row instanceof Map)) return [exists: false, value: null, key: null]
    Set&lt;String&gt; names = new LinkedHashSet&lt;String&gt;()
    names &lt;&lt; norm(field)
    (aliases[field] ?: [field]).each { names &lt;&lt; norm(it) }
    for (Object e0 : row.entrySet()) {
        Map.Entry e = (Map.Entry)e0
        if (names.contains(norm(e.key))) return [exists: true, value: e.value, key: String.valueOf(e.key)]
    }
    [exists: false, value: null, key: null]
}
def value = { Map row, String field -&gt; lookup(row, field).value }

long timeToleranceMs = intVar(&apos;competition_positions_time_tolerance_ms&apos;, 1000, 0, 3600000)
Set&lt;String&gt; integerFields = [&apos;login&apos;, &apos;order_id&apos;, &apos;notional_calculation_version&apos;] as Set
Set&lt;String&gt; ignoreCaseFields = [&apos;platform&apos;, &apos;side&apos;, &apos;account_currency&apos;, &apos;notional_status&apos;, &apos;notional_method&apos;] as Set
def compare = { String field, Object api, Object expected, String source, Map&lt;String,BigDecimal&gt; tolerances, BigDecimal defaultTolerance -&gt;
    if (blank(api) &amp;&amp; blank(expected)) {
        String note = norm(field) == &apos;storage&apos; &amp;&amp; source == &apos;DB&apos; ? &apos;API=空 和 DB 查询字段数据是空，通过&apos; : &apos;API 和 &apos; + source + &apos; 返回都是为空，通过&apos;
        return [same: true, api: &apos;&lt;empty&gt;&apos;, expected: &apos;&lt;empty&gt;&apos;, diff: &apos;N/A&apos;, percent: &apos;N/A(empty)&apos;, formula: &apos;empty == empty&apos;, note: note]
    }
    BigDecimal an = number(api)
    if (source == &apos;DB&apos; &amp;&amp; an != null &amp;&amp; an == BigDecimal.ZERO &amp;&amp; blank(expected)) {
        return [same: true, api: &apos;0&apos;, expected: &apos;&lt;empty&gt;&apos;, diff: &apos;N/A&apos;, percent: &apos;N/A(API=0,DB=empty)&apos;, formula: &apos;API=0 and DB=&lt;empty&gt;&apos;, note: &apos;API=0 和 DB 查询字段数据是空，通过&apos;]
    }
