    calcRows.eachWithIndex { Map row, int i -&gt;
        String instance=String.valueOf(row.instance_id ?: &apos;&apos;).trim(), symbol=String.valueOf(row.symbol ?: &apos;&apos;).trim(), side=String.valueOf(row.side ?: &apos;&apos;).toLowerCase()
        Object login=row.login
        BigDecimal open=number(row.open_price), lots=number(row.volume_lots), apiProfit=number(row.profit)
        String prefix=&apos;row=&apos;+(i+1)+&apos; | instance_id=&apos;+(instance?:&apos;&lt;empty&gt;&apos;)+&apos; | login=&apos;+(blank(login)?&apos;&lt;empty&gt;&apos;:idText(login))+&apos; | symbol=&apos;+(symbol?:&apos;&lt;empty&gt;&apos;)+&apos; | position_id=&apos;+String.valueOf(row.position_id ?: &apos;&lt;empty&gt;&apos;)
        try {
            if (!instance || blank(login) || !symbol || !(side in [&apos;buy&apos;,&apos;sell&apos;]) || open==null || lots==null || apiProfit==null) throw new IllegalStateException(&apos;主接口缺少profit复算必需字段&apos;)
