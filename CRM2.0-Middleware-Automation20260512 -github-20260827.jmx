            <stringProp name="filename"></stringProp>
            <stringProp name="script">// 每个循环自己独立的计数器，不会互相干扰
int count = vars.get(&quot;loop_count_Loop3&quot;) == null ? 0 : Integer.parseInt(vars.get(&quot;loop_count_Loop3&quot;));

if (count == 0) {
