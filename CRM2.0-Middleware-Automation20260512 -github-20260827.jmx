            <stringProp name="script">// 专属计数器：loop_count_Loop4
int count = vars.get(&quot;loop_count_Loop4&quot;) == null ? 0 : Integer.parseInt(vars.get(&quot;loop_count_Loop4&quot;));

if (count == 0) {
