              <stringProp name="script">import groovy.json.JsonSlurper
import org.apache.jmeter.samplers.SampleResult
import java.math.BigDecimal
import java.math.RoundingMode

List&lt;String&gt; okLines = []
List&lt;String&gt; failLines = []
List&lt;String&gt; skipLines = []
def publish = { String text, boolean success -&gt;
    vars.put(&apos;competition_history_compare_report&apos;, text ?: &apos;&apos;)
    vars.put(&apos;competition_history_compare_status&apos;, success ? &apos;PASS&apos; : &apos;FAIL&apos;)
    log.info(&apos;\n&apos; + text)
    def detail = new SampleResult()
    detail.setSampleLabel(&apos;交易大赛V1历史生命周期逐字段校验结果&apos;)
    detail.setSuccessful(success)
    detail.setResponseCode(success ? &apos;200&apos; : &apos;500&apos;)
    detail.setResponseMessage(success ? &apos;PASS&apos; : &apos;FAIL&apos;)
    detail.setResponseData(text ?: &apos;&apos;, &apos;UTF-8&apos;)
    detail.setDataType(SampleResult.TEXT)
    detail.setContentType(&apos;text/plain; charset=UTF-8&apos;)
    detail.setResponseHeaders(&apos;Content-Type: text/plain; charset=UTF-8&apos;)
    long now = System.currentTimeMillis(); detail.setStartTime(now); detail.setEndTime(now)
    prev.addSubResult(detail)
    AssertionResult.setFailure(!success)
    AssertionResult.setFailureMessage(success ? &apos;&apos; : text)
}

def blank = { Object v -&gt;
    if (v == null) return true
    if (!(v instanceof CharSequence)) return false
    String s = String.valueOf(v).trim()
    !s || s.equalsIgnoreCase(&apos;&lt;empty&gt;&apos;) || s.equalsIgnoreCase(&apos;&lt;null&gt;&apos;) || s.equalsIgnoreCase(&apos;null&apos;)
}
def number = { Object v -&gt;
    if (v == null || v instanceof Boolean) return null
    try { String s = String.valueOf(v).trim().replace(&apos;,&apos;, &apos;&apos;); s ? new BigDecimal(s) : null } catch (ignored) { null }
}
def integerNumber = { Object v -&gt; BigDecimal n = number(v); n != null &amp;&amp; n.stripTrailingZeros().scale() &lt;= 0 }
def jsonNumber = { Object v -&gt; v instanceof Number &amp;&amp; !(v instanceof Boolean) &amp;&amp; number(v) != null }
def jsonInteger = { Object v -&gt; jsonNumber(v) &amp;&amp; number(v).stripTrailingZeros().scale() &lt;= 0 }
def numText = { Object v -&gt;
    BigDecimal n = number(v)
    if (n == null) return blank(v) ? &apos;&lt;empty&gt;&apos; : String.valueOf(v)
    BigDecimal x = n.stripTrailingZeros(); x.scale() &lt; 0 ? x.setScale(0).toPlainString() : x.toPlainString()
}
def idText = { Object v -&gt; integerNumber(v) ? number(v).toBigInteger().toString() : (blank(v) ? &apos;&apos; : String.valueOf(v).trim()) }
def norm = { Object v -&gt; String.valueOf(v ?: &apos;&apos;).trim().toLowerCase().replaceAll(/[^a-z0-9]/, &apos;&apos;) }
def setOf = { String raw -&gt;
    Set&lt;String&gt; out = new LinkedHashSet&lt;String&gt;()
    String.valueOf(raw ?: &apos;&apos;).split(/[,;\r\n]+/).each { String x -&gt; if (x.trim()) out &lt;&lt; norm(x) }
    out
}
def valueMap = { String raw -&gt;
    Map&lt;String,BigDecimal&gt; out = new LinkedHashMap&lt;String,BigDecimal&gt;()
    String.valueOf(raw ?: &apos;&apos;).split(/[,;\r\n]+/).each { String token -&gt;
        int p = token.indexOf(&apos;=&apos;); BigDecimal n = p &gt; 0 ? number(token.substring(p + 1)) : null
        if (p &gt; 0 &amp;&amp; n != null &amp;&amp; n &gt;= BigDecimal.ZERO) out[norm(token.substring(0, p))] = n
    }
    out
}
def boolVar = { String name, boolean defaultValue -&gt;
    String raw = vars.get(name); raw == null || !raw.trim() ? defaultValue : raw.trim().toLowerCase() in [&apos;1&apos;,&apos;true&apos;,&apos;yes&apos;,&apos;on&apos;]
}

Map&lt;String,List&lt;String&gt;&gt; aliases = [
    instance_id:[&apos;instance_id&apos;,&apos;instanceid&apos;], platform:[&apos;platform&apos;,&apos;source&apos;], position_id:[&apos;position_id&apos;], position_lifecycle_id:[&apos;position_lifecycle_id&apos;],
    order_id:[&apos;order_id&apos;,&apos;order_ticket&apos;,&apos;position_ticket&apos;], login:[&apos;login&apos;], side:[&apos;side&apos;], symbol:[&apos;symbol&apos;], symbol_id:[&apos;symbol_id&apos;],
    volume_lots:[&apos;volume_lots&apos;,&apos;volume&apos;], open_price:[&apos;open_price&apos;,&apos;price_open&apos;], close_price:[&apos;close_price&apos;,&apos;price_close&apos;],
    open_time_ms:[&apos;open_time_ms&apos;,&apos;open_time_utc_ms&apos;], close_time_ms:[&apos;close_time_ms&apos;,&apos;close_time_utc_ms&apos;], profit:[&apos;profit&apos;],
    account_currency:[&apos;account_currency&apos;,&apos;currency&apos;], open_notional_value_usd:[&apos;open_notional_value_usd&apos;], close_notional_value_usd:[&apos;close_notional_value_usd&apos;],
    notional_status:[&apos;notional_status&apos;], notional_method:[&apos;notional_method&apos;], notional_calculation_version:[&apos;notional_calculation_version&apos;], storage:[&apos;storage&apos;,&apos;swap&apos;]
]
def lookup = { Map row, String field -&gt;
    if (!(row instanceof Map)) return [exists:false,value:null,key:null]
    Set&lt;String&gt; names = new LinkedHashSet&lt;String&gt;(); names &lt;&lt; norm(field); (aliases[field] ?: [field]).each { names &lt;&lt; norm(it) }
    for (Object entryObj : row.entrySet()) {
        Map.Entry entry = (Map.Entry)entryObj
        if (names.contains(norm(entry.key))) return [exists:true,value:entry.value,key:String.valueOf(entry.key)]
    }
    [exists:false,value:null,key:null]
}

Set&lt;String&gt; exactIntegerFields = [&apos;login&apos;,&apos;order_id&apos;,&apos;notional_calculation_version&apos;] as Set
Set&lt;String&gt; ignoreCaseFields = [&apos;platform&apos;,&apos;side&apos;,&apos;account_currency&apos;,&apos;notional_status&apos;,&apos;notional_method&apos;] as Set
def compare = { String field, Object api, Object expected, String source, Map&lt;String,BigDecimal&gt; percentMap, BigDecimal defaultPercent, Map&lt;String,BigDecimal&gt; absoluteMap, BigDecimal defaultAbsolute -&gt;
    if (blank(api) &amp;&amp; blank(expected)) {
        String note = norm(field) == &apos;storage&apos; &amp;&amp; source == &apos;DB&apos; ? &apos;API=空 和 DB 查询字段数据是空，通过&apos; : &apos;API 和 &apos; + source + &apos; 返回都是为空，通过&apos;
        return [same:true,api:&apos;&lt;empty&gt;&apos;,expected:&apos;&lt;empty&gt;&apos;,diff:&apos;N/A&apos;,percent:&apos;N/A(empty)&apos;,formula:&apos;empty == empty&apos;,note:note]
    }
    BigDecimal an = number(api)
    if (source == &apos;DB&apos; &amp;&amp; an != null &amp;&amp; an == BigDecimal.ZERO &amp;&amp; blank(expected)) return [same:true,api:&apos;0&apos;,expected:&apos;&lt;empty&gt;&apos;,diff:&apos;N/A&apos;,percent:&apos;N/A(API=0,DB=empty)&apos;,formula:&apos;API=0 and DB=&lt;empty&gt;&apos;,note:&apos;API=0 和 DB 查询字段数据是空，通过&apos;]
    if (blank(api) || blank(expected)) {
        String note = blank(api) ? &apos;API为空但&apos; + source + &apos;有值，失败&apos; : source + &apos;为空但API有值，失败&apos;
        return [same:false,api:blank(api)?&apos;&lt;empty&gt;&apos;:String.valueOf(api),expected:blank(expected)?&apos;&lt;empty&gt;&apos;:String.valueOf(expected),diff:&apos;N/A&apos;,percent:&apos;N/A(empty)&apos;,formula:&apos;empty mismatch&apos;,note:note]
    }
    BigDecimal en = number(expected)
    if (an != null &amp;&amp; en != null) {
        BigDecimal diff = an.subtract(en).abs()
        if (exactIntegerFields.contains(field)) {
            boolean same = diff == BigDecimal.ZERO &amp;&amp; integerNumber(api) &amp;&amp; integerNumber(expected)
            return [same:same,api:numText(an),expected:numText(en),diff:numText(diff),percent:same?&apos;0%&apos;:&apos;N/A(integer)&apos;,formula:&apos;整数精确比较&apos;,note:same?&apos;整数精确相等，通过&apos;:&apos;整数不相等或不是整数，失败&apos;]
        }
        BigDecimal pct = percentMap.containsKey(norm(field)) ? percentMap[norm(field)] : defaultPercent
        BigDecimal absAllowed = absoluteMap.containsKey(norm(field)) ? absoluteMap[norm(field)] : defaultAbsolute
        BigDecimal relativeAllowed = en.abs().multiply(pct).divide(new BigDecimal(&apos;100&apos;),12,RoundingMode.HALF_UP)
        BigDecimal allowed = relativeAllowed.max(absAllowed)
        boolean same = diff &lt;= allowed
        String relative = en == BigDecimal.ZERO ? (same?&apos;0%&apos;:&apos;N/A(expected=0)&apos;) : diff.multiply(new BigDecimal(&apos;100&apos;)).divide(en.abs(),10,RoundingMode.HALF_UP).stripTrailingZeros().toPlainString()+&apos;%&apos;
        return [same:same,api:numText(an),expected:numText(en),diff:numText(diff),percent:relative,formula:&apos;abs(API-&apos;+source+&apos;)=&apos;+numText(diff)+&apos; &lt;= max(abs=&apos;+numText(absAllowed)+&apos;,relative=&apos;+numText(relativeAllowed)+&apos;)=&apos;+numText(allowed),note:same?&apos;误差在允许范围内，通过&apos;:&apos;误差超限，失败&apos;]
    }
    String a=String.valueOf(api).trim(), e=String.valueOf(expected).trim()
    boolean same=ignoreCaseFields.contains(field)?a.equalsIgnoreCase(e):a==e
    [same:same,api:a,expected:e,diff:&apos;N/A&apos;,percent:&apos;N/A(text)&apos;,formula:ignoreCaseFields.contains(field)?&apos;忽略大小写文本比较&apos;:&apos;文本精确比较&apos;,note:same?&apos;文本相等，通过&apos;:&apos;文本不相等，失败&apos;]
}

String responseText=prev.getResponseDataAsString(); Object parsed
try { parsed=new JsonSlurper().parseText(responseText) }
catch(Throwable e){ publish(&apos;Assertion message: /v1/positions/history/query 响应不是合法JSON | exception=&apos;+e.class.simpleName+&apos;: &apos;+e.message+&apos;\nresponse=&apos;+responseText,false); return }
if(!(parsed instanceof Map)){ publish(&apos;Assertion message: /v1/positions/history/query 响应根节点必须是object，实际=&apos;+(parsed==null?&apos;null&apos;:parsed.getClass().name),false); return }
Map root=new LinkedHashMap((Map)parsed)
List&lt;String&gt; envelopeFields=[&apos;data&apos;,&apos;errors&apos;,&apos;next_cursor&apos;,&apos;as_of_time_ms&apos;]
envelopeFields.each{String f-&gt;if(!root.containsKey(f))failLines&lt;&lt;&apos; - [失败] | envelope.field=&apos;+f+&apos; | API=&lt;field-missing&gt; | 原因=必返字段缺失&apos;}
if(root.containsKey(&apos;data&apos;)&amp;&amp;!(root.data instanceof List))failLines&lt;&lt;&apos; - [失败] | envelope.field=data | 期望=array&apos;
if(root.containsKey(&apos;errors&apos;)&amp;&amp;!(root.errors instanceof List))failLines&lt;&lt;&apos; - [失败] | envelope.field=errors | 期望=array&apos;
if(root.containsKey(&apos;next_cursor&apos;)&amp;&amp;root.next_cursor!=null&amp;&amp;!(root.next_cursor instanceof String))failLines&lt;&lt;&apos; - [失败] | envelope.field=next_cursor | 期望=string|null | API=&apos;+root.next_cursor
BigDecimal int64Max=new BigDecimal(&apos;9223372036854775807&apos;),int64Min=new BigDecimal(&apos;-9223372036854775808&apos;)
if(root.containsKey(&apos;as_of_time_ms&apos;)&amp;&amp;(!jsonInteger(root.as_of_time_ms)||number(root.as_of_time_ms)&lt;=BigDecimal.ZERO||number(root.as_of_time_ms)&gt;int64Max))failLines&lt;&lt;&apos; - [失败] | envelope.field=as_of_time_ms | 期望=正int64 JSON整数 | API=&apos;+numText(root.as_of_time_ms)

List&lt;Map&gt; apiRows=root.data instanceof List?root.data.findAll{it instanceof Map}.collect{new LinkedHashMap((Map)it)}:[]
if(root.data instanceof List&amp;&amp;apiRows.size()!=root.data.size())failLines&lt;&lt;&apos; - [失败] | data[]存在非object元素&apos;
List&lt;Map&gt; errors=root.errors instanceof List?root.errors.findAll{it instanceof Map}.collect{new LinkedHashMap((Map)it)}:[]
if(root.errors instanceof List&amp;&amp;errors.size()!=root.errors.size())failLines&lt;&lt;&apos; - [失败] | errors[]存在非object元素&apos;
List&lt;String&gt; fields=[&apos;instance_id&apos;,&apos;platform&apos;,&apos;position_id&apos;,&apos;position_lifecycle_id&apos;,&apos;order_id&apos;,&apos;login&apos;,&apos;side&apos;,&apos;symbol&apos;,&apos;symbol_id&apos;,&apos;volume_lots&apos;,&apos;open_price&apos;,&apos;close_price&apos;,&apos;open_time_ms&apos;,&apos;close_time_ms&apos;,&apos;profit&apos;,&apos;account_currency&apos;,&apos;open_notional_value_usd&apos;,&apos;close_notional_value_usd&apos;,&apos;notional_status&apos;,&apos;notional_method&apos;,&apos;notional_calculation_version&apos;]

Set&lt;String&gt; requestedKeys=new LinkedHashSet&lt;String&gt;(); Object reqObj=vars.getObject(&apos;competition_history_request_accounts&apos;)
if(reqObj instanceof List)reqObj.findAll{it instanceof Map}.each{Map a-&gt;requestedKeys&lt;&lt;String.valueOf(a.instance_id)+&apos;|&apos;+idText(a.login)}
Set&lt;String&gt; lifecycleKeys=new LinkedHashSet&lt;String&gt;()
long fromMs; long toMs
try{fromMs=Long.parseLong(vars.get(&apos;competition_history_from_time_ms&apos;)?:&apos;0&apos;)}catch(ignored){fromMs=0L}
try{toMs=Long.parseLong(vars.get(&apos;competition_history_to_time_ms&apos;)?:&apos;0&apos;)}catch(ignored){toMs=0L}

apiRows.eachWithIndex{Map row,int i-&gt;
    fields.each{String f-&gt;if(!row.containsKey(f))failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=&apos;+f+&apos; | API=&lt;field-missing&gt; | 原因=接口缺少必返字段&apos;}
    [&apos;instance_id&apos;,&apos;position_id&apos;,&apos;position_lifecycle_id&apos;,&apos;symbol&apos;].each{String f-&gt;if(row.containsKey(f)&amp;&amp;(!(row[f] instanceof String)||!String.valueOf(row[f]).trim()))failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=&apos;+f+&apos; | 期望=非空string | API=&apos;+row[f]}
    if(row.containsKey(&apos;platform&apos;)&amp;&amp;!(row.platform in [&apos;mt4&apos;,&apos;mt5&apos;]))failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=platform | 期望=mt4或mt5 | API=&apos;+row.platform
    if(row.containsKey(&apos;side&apos;)&amp;&amp;!(row.side in [&apos;buy&apos;,&apos;sell&apos;]))failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=side | 期望=buy或sell | API=&apos;+row.side
    if(row.containsKey(&apos;login&apos;)&amp;&amp;(!jsonInteger(row.login)||number(row.login)&lt;=BigDecimal.ZERO||number(row.login)&gt;int64Max))failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=login | 期望=正int64 JSON整数 | API=&apos;+numText(row.login)
    if(row.containsKey(&apos;order_id&apos;)&amp;&amp;row.order_id!=null&amp;&amp;(!jsonInteger(row.order_id)||number(row.order_id)&lt;int64Min||number(row.order_id)&gt;int64Max))failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=order_id | 期望=int64 JSON整数|null | API=&apos;+row.order_id
    if(row.containsKey(&apos;symbol_id&apos;)&amp;&amp;row.symbol_id!=null&amp;&amp;(!(row.symbol_id instanceof String)||!String.valueOf(row.symbol_id).trim()))failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=symbol_id | 期望=非空string|null&apos;
    [&apos;volume_lots&apos;,&apos;open_price&apos;,&apos;close_price&apos;,&apos;profit&apos;].each{String f-&gt;if(row.containsKey(f)&amp;&amp;!jsonNumber(row[f]))failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=&apos;+f+&apos; | 期望=JSON number且不可为空 | API=&apos;+row[f]}
    if(jsonNumber(row.volume_lots)&amp;&amp;number(row.volume_lots)&lt;=BigDecimal.ZERO)failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=volume_lots | API=&apos;+numText(row.volume_lots)+&apos; | 原因=API返回的该持仓生命周期累计有效平仓手数volume_lots必须大于0，当前API值为&apos;+numText(row.volume_lots)+&apos; | 备注=本判断只说明API聚合字段为0或负数，不等于已证明该持仓关联的所有原始订单交易手数都为0；DB匹配成功时请结合本行DB值判断，DB=&lt;no-login-order-match&gt;时表示没有唯一匹配DB行、无法据此判断数据库订单手数&apos;
    [&apos;open_time_ms&apos;,&apos;close_time_ms&apos;].each{String f-&gt;if(row.containsKey(f)&amp;&amp;(!jsonInteger(row[f])||number(row[f])&lt;BigDecimal.ZERO||number(row[f])&gt;int64Max))failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=&apos;+f+&apos; | 期望=非负int64 JSON整数 | API=&apos;+numText(row[f])}
    if(integerNumber(row.open_time_ms)&amp;&amp;integerNumber(row.close_time_ms)&amp;&amp;number(row.open_time_ms)&gt;BigDecimal.ZERO&amp;&amp;number(row.close_time_ms)&lt;number(row.open_time_ms))failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | open_time_ms=&apos;+numText(row.open_time_ms)+&apos; | close_time_ms=&apos;+numText(row.close_time_ms)+&apos; | 原因=最终平仓时间早于首次开仓时间&apos;
    if(integerNumber(row.close_time_ms)&amp;&amp;fromMs&gt;0L&amp;&amp;number(row.close_time_ms)&lt;new BigDecimal(fromMs))failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | close_time_ms=&apos;+numText(row.close_time_ms)+&apos; | 原因=小于请求from_time_ms=&apos;+fromMs
    if(integerNumber(row.close_time_ms)&amp;&amp;toMs&gt;0L&amp;&amp;number(row.close_time_ms)&gt;new BigDecimal(toMs))failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | close_time_ms=&apos;+numText(row.close_time_ms)+&apos; | 原因=大于请求to_time_ms=&apos;+toMs
    if(row.containsKey(&apos;account_currency&apos;)&amp;&amp;row.account_currency!=null){String c=row.account_currency instanceof String?String.valueOf(row.account_currency).trim():&apos;&apos;;if(!c)failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=account_currency | 期望=非空大写string|null&apos;;else if(c!=c.toUpperCase(Locale.ROOT))failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=account_currency | API=&apos;+c+&apos; | 期望=规范化大写币种&apos;}
    [&apos;open_notional_value_usd&apos;,&apos;close_notional_value_usd&apos;].each{String f-&gt;
        if(row.containsKey(f)&amp;&amp;row[f]!=null){BigDecimal n=number(row[f]);if(!jsonNumber(row[f]))failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=&apos;+f+&apos; | 期望=JSON number|null&apos;;else if(n&lt;BigDecimal.ZERO)failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=&apos;+f+&apos; | API=&apos;+numText(n)+&apos; | 原因=名义价值不能小于0&apos;;else if(n.movePointRight(5).stripTrailingZeros().scale()&gt;0)failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=&apos;+f+&apos; | API=&apos;+numText(n)+&apos; | 原因=必须符合multipleOf=0.00001的五位小数语义&apos;}
    }
    if(row.containsKey(&apos;notional_status&apos;)&amp;&amp;!(row.notional_status in [&apos;resolved&apos;,&apos;unresolved&apos;]))failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=notional_status | API=&apos;+row.notional_status+&apos; | 期望=resolved或unresolved&apos;
    if(row.containsKey(&apos;notional_method&apos;)&amp;&amp;row.notional_method!=&apos;event_time_usd_mid_price&apos;)failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | field=notional_method | API=&apos;+row.notional_method+&apos; | 期望=event_time_usd_mid_price&apos;
    if(row.notional_status==&apos;resolved&apos;&amp;&amp;(row.open_notional_value_usd==null||row.close_notional_value_usd==null))failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | notional_status=resolved | 原因=开仓和平仓名义价值必须都非空&apos;
    String accountKey=String.valueOf(row.instance_id?:&apos;&apos;)+&apos;|&apos;+idText(row.login)
    if(requestedKeys&amp;&amp;!requestedKeys.contains(accountKey))failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | account=&apos;+accountKey+&apos; | 原因=返回请求之外账户的数据&apos;
    String lifecycleKey=String.valueOf(row.instance_id?:&apos;&apos;)+&apos;|&apos;+String.valueOf(row.position_lifecycle_id?:&apos;&apos;)
    if(!lifecycleKeys.add(lifecycleKey))failLines&lt;&lt;&apos; - [失败] | data.row=&apos;+(i+1)+&apos; | lifecycle_key=&apos;+lifecycleKey+&apos; | 原因=历史生命周期重复&apos;
}

for(int i=1;i&lt;apiRows.size();i++){
