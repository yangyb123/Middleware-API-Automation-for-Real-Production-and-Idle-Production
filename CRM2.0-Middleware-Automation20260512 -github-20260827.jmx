            <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell 预处理程序" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">// 每个循环自己独立的计数器，不会互相干扰
int count = vars.get(&quot;loop_count_Loop3&quot;) == null ? 0 : Integer.parseInt(vars.get(&quot;loop_count_Loop3&quot;));

if (count == 0) {
    // 第一次循环
    vars.put(&quot;login_val&quot;, vars.get(&quot;userSearchValue51&quot;));
    vars.put(&quot;instanceid_val&quot;, vars.get(&quot;mt5instanceid&quot;));
} else {
    // 第二次循环
    vars.put(&quot;login_val&quot;, vars.get(&quot;userSearchValue41&quot;));
    vars.put(&quot;instanceid_val&quot;, vars.get(&quot;mt4instanceid&quot;));
}

// 计数器+1
vars.put(&quot;loop_count_Loop3&quot;, String.valueOf(count + 1));</stringProp>
            </BeanShellPreProcessor>
