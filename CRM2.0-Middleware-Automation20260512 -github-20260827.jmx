            if (!account || !profitCurrency || bid==null || ask==null || contract==null) throw new IllegalStateException(&apos;辅助字段缺失 | account_currency=&apos;+account+&apos; | currency_profit=&apos;+profitCurrency+&apos; | bid=&apos;+numText(bid)+&apos; | ask=&apos;+numText(ask)+&apos; | contract_size=&apos;+numText(contract)+&apos; | symbol_error=&apos;+String.valueOf(value(info,&apos;__error&apos;) ?: &apos;&apos;))
            BigDecimal current=side==&apos;sell&apos;?ask:bid
            BigDecimal raw=side==&apos;sell&apos;?open.subtract(ask).multiply(contract).multiply(lots):bid.subtract(open).multiply(contract).multiply(lots)
