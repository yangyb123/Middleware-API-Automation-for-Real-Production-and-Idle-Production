            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="提取并汇总items每个订单profit为history_positions_profit" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import java.math.BigDecimal
import org.apache.jmeter.samplers.SampleResult

def decimalProfit = { Object value, String label -&gt;
    String raw = value == null ? &apos;&apos; : String.valueOf(value).trim().replace(&apos;,&apos;, &apos;&apos;)
    if (!raw || !(raw ==~ /^[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?$/)) throw new AssertionError(label + &apos;不是有效数值，实际=[&apos; + raw + &apos;]&apos;)
    new BigDecimal(raw)
}
def root = new JsonSlurper().parseText(prev.getResponseDataAsString() ?: &apos;{}&apos;)
if (!(root instanceof Map) || decimalProfit(root.code, &apos;code&apos;).compareTo(BigDecimal.ZERO) != 0 || String.valueOf(root.msg ?: &apos;&apos;) != &apos;ok&apos;) throw new AssertionError(&apos;list_history_positions业务失败: code=&apos; + root.code + &apos;, msg=&apos; + root.msg)
List items = root.data instanceof Map &amp;&amp; root.data.items instanceof List ? root.data.items : []
if (items.isEmpty()) throw new AssertionError(&apos;list_history_positions响应data.items[]为空，本次没有可提取和汇总的历史平仓订单&apos;)
BigDecimal totalProfit = BigDecimal.ZERO
List&lt;String&gt; profitValues = []
List&lt;String&gt; profitDetailLines = []
items.eachWithIndex { Object rawItem, int index -&gt;
    if (!(rawItem instanceof Map)) throw new AssertionError(&apos;data.items[&apos; + index + &apos;]不是对象&apos;)
    Map item = (Map)rawItem
    BigDecimal value = decimalProfit(item.profit, &apos;data.items[&apos; + index + &apos;].profit&apos;)
    totalProfit = totalProfit.add(value);profitValues &lt;&lt; value.toPlainString()
    profitDetailLines &lt;&lt; &apos;item[&apos; + index + &apos;] | instance_id=&apos; + item.instance_id + &apos; | login=&apos; + item.login + &apos; | order_ticket=&apos; + item.order_ticket + &apos; | position_ticket=&apos; + item.position_ticket + &apos; | deal_ticket=&apos; + item.deal_ticket + &apos; | symbol=&apos; + item.symbol + &apos; | currency=&apos; + item.currency + &apos; | close_time_utc_ms=&apos; + item.close_time_utc_ms + &apos; | profit=&apos; + value.toPlainString()
}
vars.put(&apos;history_positions_profit&apos;, totalProfit.stripTrailingZeros().toPlainString())
vars.put(&apos;history_positions_profit_values&apos;, profitValues.join(&apos; + &apos;))
vars.put(&apos;history_positions_profit_count&apos;, String.valueOf(items.size()))
List&lt;String&gt; extractionReport = []
extractionReport &lt;&lt; &apos;list_history_positions profit提取与汇总 | status=PASS&apos;
extractionReport &lt;&lt; &apos;接口: POST /crm20/list_history_positions | code=&apos; + root.code + &apos; | msg=&apos; + root.msg
extractionReport &lt;&lt; &apos;账户: instanceid=&apos; + vars.get(&apos;instanceid&apos;) + &apos; | login=&apos; + vars.get(&apos;login&apos;)
extractionReport &lt;&lt; &apos;时间范围: close_time_from_utc_ms=&apos; + vars.get(&apos;close_time_from_utc_ms&apos;) + &apos; | close_time_to_utc_ms=&apos; + vars.get(&apos;close_time_to_utc_ms&apos;)
extractionReport &lt;&lt; &apos;订单数量: data.total=&apos; + root.data.total + &apos; | data.items.size=&apos; + items.size()
extractionReport &lt;&lt; &apos;求和公式: history_positions_profit = SUM(data.items[].profit) = &apos; + profitValues.join(&apos; + &apos;) + &apos; = &apos; + totalProfit.toPlainString()
extractionReport &lt;&lt; &apos;已生成变量: history_positions_profit=&apos; + vars.get(&apos;history_positions_profit&apos;) + &apos; | history_positions_profit_count=&apos; + vars.get(&apos;history_positions_profit_count&apos;)
extractionReport &lt;&lt; &apos;金额口径: 累加items[].profit（账户原生币种），不累加profit_reporting。&apos;
extractionReport &lt;&lt; &apos;&apos; &lt;&lt; &apos;【每个订单profit提取明细】&apos;;extractionReport.addAll(profitDetailLines)
String extractionText = extractionReport.join(&apos;\n&apos;)
vars.put(&apos;history_positions_profit_report&apos;, extractionText)
log.info(&apos;\n&apos; + extractionText)
def extractionResult = new SampleResult();extractionResult.setSampleLabel(&apos;01-list_history_positions-profit提取与求和结果&apos;);extractionResult.setSuccessful(true);extractionResult.setResponseCode(&apos;200&apos;);extractionResult.setResponseMessage(&apos;PASS&apos;);extractionResult.setResponseData(extractionText, &apos;UTF-8&apos;);extractionResult.setDataType(SampleResult.TEXT);extractionResult.setContentType(&apos;text/plain; charset=UTF-8&apos;);long extractionNow=System.currentTimeMillis();extractionResult.setStartTime(extractionNow);extractionResult.setEndTime(extractionNow);prev.addSubResult(extractionResult)</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="校验equity差值与历史平仓profit合计" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import java.math.BigDecimal
import org.apache.jmeter.samplers.SampleResult

def parseDecimal = { Object value, String label -&gt;
    String raw = value == null ? &apos;&apos; : String.valueOf(value).trim().replace(&apos;,&apos;, &apos;&apos;)
    if (!raw || !(raw ==~ /^[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?$/)) {
        throw new AssertionError(label + &apos;不是有效数值，实际=[&apos; + raw + &apos;]&apos;)
    }
    return new BigDecimal(raw)
}

String responseText = prev.getResponseDataAsString()
Object responseJson
try {
    responseJson = new JsonSlurper().parseText(responseText ?: &apos;{}&apos;)
} catch (Throwable ex) {
    throw new AssertionError(&apos;list_history_positions响应不是合法JSON: &apos; + ex.message)
}
if (!(responseJson instanceof Map)) {
    throw new AssertionError(&apos;list_history_positions响应根节点不是object&apos;)
}
Map root = (Map) responseJson
if (parseDecimal(root.code, &apos;code&apos;).compareTo(BigDecimal.ZERO) != 0 || String.valueOf(root.msg ?: &apos;&apos;) != &apos;ok&apos;) {
    throw new AssertionError(&apos;list_history_positions业务失败: code=&apos; + root.code + &apos;, msg=&apos; + root.msg)
}

List items = root.data instanceof Map &amp;&amp; root.data.items instanceof List ? (List) root.data.items : []
if (items.isEmpty()) {
    throw new AssertionError(&apos;list_history_positions响应data.items[]为空，不允许权益差=0与历史profit合计=0产生假通过&apos;)
}

BigDecimal historyPositionsProfit = BigDecimal.ZERO
List&lt;String&gt; itemLines = []
List&lt;String&gt; profitValues = []
items.eachWithIndex { Object rawItem, int index -&gt;
    if (!(rawItem instanceof Map)) throw new AssertionError(&apos;data.items[&apos; + index + &apos;]不是object&apos;)
    Map item = (Map) rawItem
    BigDecimal itemProfit = parseDecimal(item.profit, &apos;data.items[&apos; + index + &apos;].profit&apos;)
    historyPositionsProfit = historyPositionsProfit.add(itemProfit)
    profitValues &lt;&lt; itemProfit.toPlainString()
    itemLines &lt;&lt; &apos;item[&apos; + index + &apos;] | instance_id=&apos; + item.instance_id + &apos; | login=&apos; + item.login +
        &apos; | order_ticket=&apos; + item.order_ticket + &apos; | position_ticket=&apos; + item.position_ticket +
        &apos; | deal_ticket=&apos; + item.deal_ticket + &apos; | symbol=&apos; + item.symbol +
        &apos; | currency=&apos; + item.currency + &apos; | close_time_utc_ms=&apos; + item.close_time_utc_ms +
        &apos; | profit=&apos; + itemProfit.toPlainString()
}

BigDecimal equityAA = parseDecimal(vars.get(&apos;equityAA&apos;), &apos;equityAA&apos;)
BigDecimal equityBB = parseDecimal(vars.get(&apos;equityBB&apos;), &apos;equityBB&apos;)
BigDecimal calculatedUserInfoProfit = equityBB.subtract(equityAA)
BigDecimal difference = calculatedUserInfoProfit.subtract(historyPositionsProfit)
boolean same = difference.compareTo(BigDecimal.ZERO) == 0

vars.put(&apos;cale_user_info_profit&apos;, calculatedUserInfoProfit.stripTrailingZeros().toPlainString())
vars.put(&apos;history_positions_profit&apos;, historyPositionsProfit.stripTrailingZeros().toPlainString())
vars.put(&apos;user_info_profit_compare_difference&apos;, difference.stripTrailingZeros().toPlainString())

List&lt;String&gt; report = []
report &lt;&lt; &apos;Assertion message: equity差值与历史平仓profit合计对比 | status=&apos; + (same ? &apos;PASS&apos; : &apos;FAIL&apos;)
report &lt;&lt; &apos;接口: POST /crm20/list_history_positions&apos;
report &lt;&lt; &apos;账户: instanceid=&apos; + vars.get(&apos;instanceid&apos;) + &apos; | login=&apos; + vars.get(&apos;login&apos;) +
    &apos; | close_time_from_utc_ms=&apos; + vars.get(&apos;close_time_from_utc_ms&apos;) +
    &apos; | close_time_to_utc_ms=&apos; + vars.get(&apos;close_time_to_utc_ms&apos;)
report &lt;&lt; &apos;权益差公式: cale_user_info_profit = equityBB - equityAA = &apos; + equityBB.toPlainString() +
    &apos; - &apos; + equityAA.toPlainString() + &apos; = &apos; + calculatedUserInfoProfit.toPlainString()
report &lt;&lt; &apos;历史盈亏公式: history_positions_profit = SUM(data.items[].profit) = &apos; +
    profitValues.join(&apos; + &apos;) + &apos; = &apos; + historyPositionsProfit.toPlainString() +
    &apos; | items数量=&apos; + items.size()
report &lt;&lt; &apos;比较公式: &apos; + calculatedUserInfoProfit.toPlainString() + &apos; - &apos; +
    historyPositionsProfit.toPlainString() + &apos; = &apos; + difference.toPlainString() +
    &apos; | 期望差值=0 | 结果=&apos; + (same ? &apos;相等，通过&apos; : &apos;不相等，失败&apos;)
report &lt;&lt; &apos;金额口径: equity与items[].profit均使用账户原生币种；不使用profit_reporting。&apos;
report &lt;&lt; &apos;&apos; &lt;&lt; &apos;【订单profit明细】&apos;
report.addAll(itemLines)

String finalReport = report.join(&apos;\n&apos;)
log.info(&apos;\n&apos; + finalReport)
vars.put(&apos;user_info_profit_compare_report&apos;, finalReport)
vars.put(&apos;user_info_profit_compare_status&apos;, same ? &apos;PASS&apos; : &apos;FAIL&apos;)

def detail = new SampleResult()
detail.setSampleLabel(&apos;02-equity差值与history_positions_profit比较结果&apos;)
detail.setSuccessful(same)
detail.setResponseCode(same ? &apos;200&apos; : &apos;500&apos;)
detail.setResponseMessage(same ? &apos;PASS&apos; : &apos;FAIL&apos;)
detail.setResponseData(finalReport, &apos;UTF-8&apos;)
detail.setDataType(SampleResult.TEXT)
detail.setContentType(&apos;text/plain; charset=UTF-8&apos;)
long now = System.currentTimeMillis()
detail.setStartTime(now)
detail.setEndTime(now)
prev.addSubResult(detail)

AssertionResult.setFailure(!same)
AssertionResult.setFailureMessage(finalReport)</stringProp>
