            <stringProp name="parameters"></stringProp>
            <stringProp name="script">String csvName = &apos;账户级财务指标-数据库校验.csv&apos;
File csvFile = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), csvName)
if (!csvFile.exists()) {
    throw new AssertionError(&apos;账户级财务指标CSV文件不存在: &apos; + csvFile.getPath())
}
def dataLines = csvFile.readLines(&apos;UTF-8&apos;).findAll { it?.trim() }
if (dataLines.size() &lt;= 1) {
    throw new AssertionError(&apos;账户级财务指标CSV没有数据行: &apos; + csvFile.getPath())
}

String shujuku = (vars.get(&apos;shujuku&apos;) ?: &apos;&apos;).trim()
String instanceId = (vars.get(&apos;order_instanceid_val&apos;) ?: vars.get(&apos;instanceid_val&apos;) ?: vars.get(&apos;instance_id&apos;) ?: &apos;&apos;).trim()
String login = (vars.get(&apos;order_login&apos;) ?: vars.get(&apos;login&apos;) ?: &apos;&apos;).trim()

if (!(shujuku in [&apos;0&apos;, &apos;1&apos;])) throw new AssertionError(&apos;账户级财务指标 shujuku只能是0或1，当前=&apos; + shujuku)
if (!instanceId) throw new AssertionError(&apos;账户级财务指标 order_instanceid_val不能为空&apos;)
if (!login) throw new AssertionError(&apos;账户级财务指标 order_login/login不能为空&apos;)

String platform = instanceId.toUpperCase().contains(&apos;MT5&apos;) ? &apos;MT5&apos; : (instanceId.toUpperCase().contains(&apos;MT4&apos;) ? &apos;MT4&apos; : &apos;&apos;)
if (!platform) throw new AssertionError(&apos;账户级财务指标 order_instanceid_val只支持MT4_*/MT5_*，当前=&apos; + instanceId)

String normalizedInstanceId = instanceId.toUpperCase()
Map supportedDbInstances = [
    &apos;MT4_1&apos;    : [platform: &apos;MT4&apos;, pool: &apos;mysqlMT4&apos;, schema: &apos;mt4_report&apos;, usersTable: &apos;MT4_USERS&apos;, tradesTable: &apos;MT4_TRADES&apos;],
    &apos;MT5_1&apos;    : [platform: &apos;MT5&apos;, pool: &apos;mysqlMT5&apos;, schema: &apos;mt5_report&apos;],
    &apos;MT4_2&apos;    : [platform: &apos;MT4&apos;, pool: &apos;mt4demo_report_MT4_2&apos;, schema: &apos;mt4demo_report&apos;, usersTable: &apos;mt4_users&apos;, tradesTable: &apos;mt4_trades&apos;],
    &apos;MT4_3&apos;    : [platform: &apos;MT4&apos;, pool: &apos;mt4demo_report_MT4_3&apos;, schema: &apos;mt4demo_report&apos;, usersTable: &apos;mt4_users&apos;, tradesTable: &apos;mt4_trades&apos;],
    &apos;MT5_1_TS1&apos;: [platform: &apos;MT5&apos;, pool: &apos;mt51ts1_report&apos;, schema: &apos;mt51ts1_report&apos;],
    &apos;MT5_1_TS2&apos;: [platform: &apos;MT5&apos;, pool: &apos;mt51ts2_report&apos;, schema: &apos;mt51ts2_report&apos;]
]
Map dbRoute = supportedDbInstances[normalizedInstanceId]
if (shujuku == &apos;1&apos; &amp;&amp; dbRoute == null) {
    throw new AssertionError(&apos;账户级财务指标数据库校验不支持实例=&apos; + instanceId + &apos;，支持实例=&apos; + supportedDbInstances.keySet().join(&apos;,&apos;))
}
if (dbRoute != null) platform = dbRoute.platform

vars.put(&apos;acct_metrics_shujuku&apos;, shujuku)
vars.put(&apos;acct_metrics_login&apos;, login)
vars.put(&apos;acct_metrics_instanceid&apos;, instanceId)
vars.put(&apos;acct_metrics_db_platform&apos;, platform)
vars.put(&apos;acct_metrics_db_pool&apos;, dbRoute?.pool ?: &apos;&apos;)
vars.put(&apos;acct_metrics_db_schema&apos;, dbRoute?.schema ?: &apos;&apos;)
vars.put(&apos;acct_metrics_mt4_users_table&apos;, dbRoute?.usersTable ?: &apos;&apos;)
vars.put(&apos;acct_metrics_mt4_trades_table&apos;, dbRoute?.tradesTable ?: &apos;&apos;)
vars.put(&apos;order_login&apos;, login)
vars.put(&apos;order_instanceid_val&apos;, instanceId)
vars.putObject(&apos;db_acct_metrics_rows&apos;, [])
log.info(&apos;account metrics init | shujuku=&apos; + shujuku + &apos; | platform=&apos; + platform + &apos; | instanceid=&apos; + instanceId + &apos; | dbPool=&apos; + (dbRoute?.pool ?: &apos;CSV&apos;) + &apos; | dbSchema=&apos; + (dbRoute?.schema ?: &apos;CSV&apos;) + &apos; | login=&apos; + login)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Sampler>
