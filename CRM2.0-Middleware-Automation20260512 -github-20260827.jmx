        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="交易大赛持仓CSV循环">
          <stringProp name="LoopController.loops">${__groovy(def f = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir() + File.separator + &apos;交易大赛-批量查询指定账户的当前未平仓持仓.csv&apos;); if (!f.exists()) return 0; def lines = f.readLines(&apos;UTF-8&apos;); if (lines.size() &lt;= 1) return 0; boolean hasDb = false; int csvCount = 0; for (int i = 1; i &lt; lines.size(); i++) { String line = lines.get(i); if (line != null &amp;&amp; line.trim().length() &gt; 0) { int p = -1; for (int j = 0; j &lt; line.length(); j++) { if ((int)line.charAt(j) == 44) { p = j; break } }; String first = p &lt; 0 ? line : line.take(p); if (first.length() &gt; 0 &amp;&amp; first.charAt(0) == (65279 as char)) first = first.drop(1); first = first.trim(); if (first.length() &gt;= 2 &amp;&amp; first.charAt(0) == (&apos;&quot;&apos; as char) &amp;&amp; first.charAt(first.length() - 1) == (&apos;&quot;&apos; as char)) first = first.drop(1).take(first.length() - 2).trim(); if (first == &apos;1&apos;) hasDb = true; else if (first == &apos;0&apos;) csvCount++ } }; return csvCount + (hasDb ? 1 : 0))}</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
