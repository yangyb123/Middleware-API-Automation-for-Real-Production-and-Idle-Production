    if (cent.contains(to) &amp;&amp; from != &apos;USD&apos;) { def a=rate(from,&apos;USD&apos;,instance,rawProfit,primary); if (a.rate!=null) return [rate:a.rate*100,path:&apos;(&apos;+a.path+&apos;)*100&apos;,detail:a.detail+&apos; * cent100&apos;] }
    if (cent.contains(from) &amp;&amp; to != &apos;USD&apos;) { def a=rate(&apos;USD&apos;,to,instance,rawProfit,primary); if (a.rate!=null) return [rate:a.rate*new BigDecimal(&apos;0.01&apos;),path:&apos;0.01*(&apos;+a.path+&apos;)&apos;,detail:&apos;cent0.01 * &apos;+a.detail] }
    if (from!=&apos;USD&apos; &amp;&amp; to!=&apos;USD&apos;) { def a=rate(from,&apos;USD&apos;,instance,rawProfit,primary), b=rate(&apos;USD&apos;,to,instance,rawProfit,primary); if (a.rate!=null &amp;&amp; b.rate!=null) return [rate:a.rate*b.rate,path:&apos;(&apos;+a.path+&apos;)*(&apos;+b.path+&apos;)&apos;,detail:&apos;(&apos;+a.detail+&apos;)*(&apos;+b.detail+&apos;)&apos;] }
