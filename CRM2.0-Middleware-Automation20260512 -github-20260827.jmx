    }
    for (String candidate : reverseCandidates) {
        Map q = symbolInfo(instance,candidate); BigDecimal b=number(value(q,&apos;bid&apos;)), a=number(value(q,&apos;ask&apos;))
        BigDecimal m = formula3Precision &amp;&amp; b!=null &amp;&amp; a!=null &amp;&amp; b&gt;BigDecimal.ZERO &amp;&amp; a&gt;BigDecimal.ZERO ? b.add(a).divide(new BigDecimal(&apos;2&apos;),12,RoundingMode.HALF_UP) : mid5(b,a)
        attempts &lt;&lt; candidate+&apos;=&apos;+(value(q,&apos;__error&apos;) ?: (m==null?&apos;invalid_bid_ask&apos;:&apos;found&apos;))
        if (m != null) { BigDecimal inv=formula3Precision?new BigDecimal(&apos;2&apos;).divide(b.add(a),8,RoundingMode.HALF_UP):BigDecimal.ONE.divide(m,10,RoundingMode.HALF_UP).setScale(5,RoundingMode.HALF_UP); return [rate:inv,querySymbol:candidate,direction:(formula3Precision?&apos;inverse USD&apos;+ccy+&apos;: 2/(Bid+Ask)&apos;:&apos;inverse 1/MidPrice&apos;),bid:b,ask:a,attempts:attempts.join(&apos; -&gt; &apos;)] }
    }
