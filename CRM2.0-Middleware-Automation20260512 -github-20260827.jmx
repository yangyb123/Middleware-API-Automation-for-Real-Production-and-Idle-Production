            String profitCurrency = String.valueOf(value(info,&apos;currency_profit&apos;) ?: &apos;&apos;).trim().toUpperCase()
            BigDecimal contract = number(value(info,&apos;contract_size&apos;)), primaryBid=number(value(info,&apos;bid&apos;)), primaryAsk=number(value(info,&apos;ask&apos;)), pm=number(value(info,&apos;profit_mode&apos;))
