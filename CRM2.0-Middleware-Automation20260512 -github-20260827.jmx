          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="获取汇总的已平仓仓位-数据库校验-${history_pos_login}-${history_pos_instanceid}" enabled="true">
            <intProp name="HTTPSampler.connect_timeout">3000</intProp>
            <intProp name="HTTPSampler.response_timeout">5000</intProp>
            <stringProp name="HTTPSampler.domain">${middlewareip}</stringProp>
            <stringProp name="HTTPSampler.port">${port}</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">utf-8</stringProp>
            <stringProp name="HTTPSampler.path">/crm20/get_history_position_ex?instanceid=${instanceid}&amp;login=${login}&amp;close_time_utc_ms__gte=1767230437000&amp;_sort_by=close_time_utc_ms&amp;_sort_order=desc&amp;_limit=500</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="数据库或CSV字段对比断言-汇总已平仓仓位" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">
import groovy.json.JsonSlurper
import org.apache.jmeter.samplers.SampleResult
import groovy.transform.Field
import java.math.BigDecimal
import java.text.SimpleDateFormat
import java.time.Instant
import java.time.LocalDateTime
import java.time.ZoneId
import java.time.format.DateTimeFormatter

def text = prev.getResponseDataAsString()
def parsed
try {
    parsed = new JsonSlurper().parseText(text ?: &apos;{}&apos;)
} catch (Throwable e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;接口响应不是合法JSON: &apos; + e.message + &apos;\nresponse=&apos; + text)
    return
}

List asRows(obj) {
    if (obj == null) return []
    if (obj instanceof List) return obj.findAll { it instanceof Map }
    if (obj instanceof Map) {
        for (k in [&apos;data&apos;, &apos;rows&apos;, &apos;records&apos;, &apos;list&apos;, &apos;items&apos;, &apos;result&apos;, &apos;results&apos;]) {
            def v = obj[k]
            if (v instanceof List) return v.findAll { it instanceof Map }
            if (v instanceof Map) {
                def nested = asRows(v)
                if (nested) return nested
            }
        }
        def firstList = obj.values().find { it instanceof List &amp;&amp; it.any { it instanceof Map } }
        if (firstList instanceof List) return firstList.findAll { it instanceof Map }
        return [obj]
    }
    return []
}

Map rowToMap(row) {
    def out = new LinkedHashMap()
    if (row instanceof Map) {
        row.each { k, v -&gt; out[String.valueOf(k)] = v }
    } else {
        try {
            row.metaClass.properties.each { p -&gt;
                if (p.name != &apos;class&apos;) out[p.name] = row.&quot;${p.name}&quot;
            }
        } catch (ignored) {}
    }
    return out
}

String normKey(String s) {
    return (s ?: &apos;&apos;).replaceAll(&apos;[^A-Za-z0-9]&apos;, &apos;&apos;).toLowerCase()
}

@Field def aliases = [
    &apos;position_ticket&apos;: [&apos;position_ticket&apos;, &apos;PositionID&apos;, &apos;POSITIONID&apos;, &apos;TICKET&apos;, &apos;ticket&apos;, &apos;position&apos;, &apos;Position&apos;],
    &apos;order_ticket&apos;   : [&apos;order_ticket&apos;, &apos;Order&apos;, &apos;ORDER&apos;, &apos;order&apos;, &apos;TICKET&apos;, &apos;ticket&apos;],
    &apos;deal_ticket&apos;    : [&apos;deal_ticket&apos;, &apos;Deal&apos;, &apos;DEAL&apos;, &apos;deal&apos;],
    &apos;login&apos;          : [&apos;login&apos;, &apos;Login&apos;, &apos;LOGIN&apos;],
    &apos;symbol&apos;         : [&apos;symbol&apos;, &apos;Symbol&apos;, &apos;SYMBOL&apos;],
    &apos;source&apos;         : [&apos;source&apos;, &apos;platform&apos;],
    &apos;instance_id&apos;    : [&apos;instance_id&apos;, &apos;instanceid&apos;, &apos;instanceId&apos;],
    &apos;open_price&apos;     : [&apos;open_price&apos;, &apos;price_open&apos;, &apos;OPEN_PRICE&apos;, &apos;PriceOpen&apos;, &apos;Price&apos;],
    &apos;close_price&apos;    : [&apos;close_price&apos;, &apos;price_close&apos;, &apos;CLOSE_PRICE&apos;, &apos;PriceClose&apos;],
    &apos;open_time_utc_ms&apos;: [&apos;open_time_utc_ms&apos;, &apos;open_time&apos;, &apos;OPEN_TIME&apos;, &apos;TimeCreate&apos;, &apos;TimeMsc&apos;],
    &apos;close_time_utc_ms&apos;: [&apos;close_time_utc_ms&apos;, &apos;close_time&apos;, &apos;CLOSE_TIME&apos;, &apos;Time&apos;, &apos;TimeMsc&apos;],
    &apos;volume&apos;         : [&apos;volume&apos;, &apos;volume_lots&apos;, &apos;VOLUME&apos;, &apos;Volume&apos;, &apos;VolumeClosed&apos;],
    &apos;action&apos;         : [&apos;action&apos;, &apos;Action&apos;, &apos;CMD&apos;, &apos;cmd&apos;],
    &apos;swap&apos;           : [&apos;swap&apos;, &apos;SWAPS&apos;, &apos;Storage&apos;],
    &apos;commission&apos;     : [&apos;commission&apos;, &apos;COMMISSION&apos;, &apos;Commission&apos;],
    &apos;fee&apos;            : [&apos;fee&apos;, &apos;Fee&apos;],
    &apos;digits&apos;         : [&apos;digits&apos;, &apos;Digits&apos;, &apos;DIGITS&apos;],
    &apos;profit&apos;         : [&apos;profit&apos;, &apos;PROFIT&apos;, &apos;Profit&apos;],
    &apos;account_mode&apos;   : [&apos;account_mode&apos;, &apos;accountMode&apos;]
]

def findKey(Map m, String field) {
    if (m.containsKey(field)) return field
    for (a in (aliases[field] ?: [])) {
        if (m.containsKey(a)) return a
    }
    def want = normKey(field)
    return m.keySet().find { normKey(String.valueOf(it)) == want }
}

def valueOf(Map m, String field) {
    def k = findKey(m, field)
    return k == null ? null : m[k]
}

String idOf(Map row) {
    for (f in [&apos;position_ticket&apos;, &apos;PositionID&apos;, &apos;position&apos;, &apos;order_ticket&apos;, &apos;Order&apos;, &apos;TICKET&apos;, &apos;orderId&apos;]) {
        def v = valueOf(row, f)
        if (v != null &amp;&amp; String.valueOf(v).trim()) return cleanNumber(String.valueOf(v))
    }
    return &apos;&apos;
}

String cleanNumber(String s) {
    if (s == null) return &apos;&apos;
    def t = s.trim()
    if (t ==~ /^-?\d+\.0+$/) return t.substring(0, t.indexOf(&apos;.&apos;))
    return t
}

boolean blank(v) {
    return v == null || String.valueOf(v).trim() == &apos;&apos; || String.valueOf(v).trim() == &apos;&lt;EOF&gt;&apos;
}

boolean numeric(v) {
    if (v == null) return false
    return String.valueOf(v).trim() ==~ /^-?\d+(\.\d+)?$/
}

boolean timeField(String f) {
    def n = (f ?: &apos;&apos;).toLowerCase()
    return n.contains(&apos;time&apos;) || n.endsWith(&apos;utc_ms&apos;) || n.contains(&apos;updated_utc_ms&apos;)
}

Date parseDateLike(v) {
    if (blank(v)) return null
    if (v instanceof java.util.Date) return v
    def s = String.valueOf(v).trim()
    if (numeric(s)) {
        BigDecimal n = new BigDecimal(s)
        long ms = n.abs().compareTo(new BigDecimal(&apos;100000000000&apos;)) &gt;= 0 ? n.longValue() : n.longValue() * 1000L
        return new Date(ms)
    }
    s = s.replace(&apos;T&apos;, &apos; &apos;)
    if (s.contains(&apos;.&apos;)) s = s.substring(0, s.indexOf(&apos;.&apos;))
    for (fmt in [&apos;yyyy-MM-dd HH:mm:ss&apos;, &apos;yyyy-MM-dd HH:mm&apos;, &apos;yyyy-MM-dd&apos;]) {
        try {
            def sdf = new SimpleDateFormat(fmt)
            sdf.setLenient(false)
            return sdf.parse(s)
        } catch (ignored) {}
    }
    return null
}

String fmt(Date d, String tz) {
    if (d == null) return &apos;&apos;
    def sdf = new SimpleDateFormat(&apos;yyyy-MM-dd HH:mm:ss&apos;)
    sdf.setTimeZone(TimeZone.getTimeZone(tz))
    return sdf.format(d)
}

String normalizeApiTime(v) {
    def d = parseDateLike(v)
    return d == null ? String.valueOf(v ?: &apos;&apos;).trim() : fmt(d, &apos;UTC&apos;)
}

String displayApiTime(v) {
    def d = parseDateLike(v)
    return d == null ? String.valueOf(v ?: &apos;&apos;).trim() : fmt(d, &apos;Asia/Shanghai&apos;)
}

String normalizeCsvTime(v) {
    def d = parseDateLike(v)
    return d == null ? String.valueOf(v ?: &apos;&apos;).replace(&apos;T&apos;, &apos; &apos;).trim() : fmt(d, &apos;Asia/Shanghai&apos;)
}

String normalizeDbTime(v) {
    // JDBC DB datetime values already contain the wall-clock value used by the
    // report. Preserve yyyy-MM-dd HH:mm:ss from their rendered text; formatting
    // the underlying Date/Timestamp instant in Asia/Shanghai adds an incorrect
    // UTC+8 offset (for example 08:11:08 becomes 16:11:08).
    if (!numeric(v)) {
        String raw = String.valueOf(v ?: &apos;&apos;).replace(&apos;T&apos;, &apos; &apos;).trim()
        def matched = (raw =~ /^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})/)
        if (matched.find()) return matched.group(1)
    }
    def d = parseDateLike(v)
    if (d == null) return String.valueOf(v ?: &apos;&apos;).replace(&apos;T&apos;, &apos; &apos;).trim()
    return numeric(v) ? fmt(d, &apos;UTC&apos;) : fmt(d, &apos;Asia/Shanghai&apos;)
}

String normalizePlain(v) {
    if (blank(v)) return &apos;&apos;
    def s = String.valueOf(v).trim()
    if (numeric(s)) {
        try {
            BigDecimal n = new BigDecimal(s).stripTrailingZeros()
            return n.toPlainString()
        } catch (ignored) {}
    }
    return s
}

def decimalValue = { v -&gt;
    if (blank(v)) return null
    def s = String.valueOf(v).trim()
    if (!numeric(s)) return null
    try { return new BigDecimal(s) } catch (ignored) { return null }
}
def decimalText = { BigDecimal n -&gt;
    if (n == null) return &apos;null&apos;
    try {
        return n.setScale(8, java.math.RoundingMode.HALF_UP).stripTrailingZeros().toPlainString()
    } catch (Throwable ignored) {
        return n.toPlainString()
    }
}
def percentText = { BigDecimal n -&gt; decimalText(n) + &apos;%&apos; }

boolean sameValue(String field, api, expected, boolean expectedIsDb) {
    if (timeField(field)) {
        if (expectedIsDb) {
            return normalizeApiTime(api) == normalizeDbTime(expected)
        }
        return normalizeCsvTime(api) == normalizeCsvTime(expected)
    }
    return normalizePlain(api) == normalizePlain(expected)
}

String rendered(String field, v, boolean apiSide, String sourceName) {
    if (blank(v)) return &apos;&lt;empty&gt;&apos;
    if (timeField(field)) {
        if (sourceName == &apos;DB&apos;) {
            if (apiSide) return String.valueOf(v) + &apos; -&gt; &apos; + displayApiTime(v) + &apos; -&gt; 对比值(减8小时)=&apos; + normalizeApiTime(v)
            return String.valueOf(v) + &apos; -&gt; &apos; + normalizeDbTime(v)
        }
        return String.valueOf(v) + &apos; -&gt; &apos; + displayApiTime(v) + &apos; -&gt; 对比值(不减8小时)=&apos; + normalizeCsvTime(v)
    }
    return String.valueOf(v)
}

String dbDisabledRaw = vars.get(&apos;history_pos_disabled_compare_fields&apos;) ?: &apos;&apos;
String csvDisabledRaw = vars.get(&apos;history_pos_csv_disabled_compare_fields&apos;) ?: &apos;&apos;

String shujuku = vars.get(&apos;history_pos_shujuku&apos;) ?: vars.get(&apos;shujuku&apos;) ?: &apos;0&apos;
String login = vars.get(&apos;history_pos_login&apos;) ?: vars.get(&apos;order_login&apos;) ?: vars.get(&apos;login&apos;) ?: &apos;&apos;
String instanceId = vars.get(&apos;history_pos_instanceid&apos;) ?: vars.get(&apos;order_instanceid_val&apos;) ?: &apos;&apos;
def apiRows = asRows(parsed).collect { rowToMap(it) }
if (!apiRows) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;接口没有返回可对比的汇总已平仓仓位记录 | login=&apos; + login + &apos; | instanceid=&apos; + instanceId)
    return
}

Map apiRow = null
Map expectedRow = null
boolean expectedIsDb = shujuku == &apos;1&apos;
String sourceName = expectedIsDb ? &apos;DB&apos; : &apos;CSV&apos;
String disabledRaw = expectedIsDb ? dbDisabledRaw : csvDisabledRaw
String disabledConfigName = expectedIsDb ? &apos;history_pos_disabled_compare_fields(DB/API)&apos; : &apos;history_pos_csv_disabled_compare_fields(CSV/API)&apos;
Set disabled = (disabledRaw
    .split(/[，,\s]+/)
    .collect { it.trim() }
    .findAll { it })
    .collect { normKey(it) } as Set
String matchedId = &apos;&apos;
String dbFirstId = &apos;&apos;
String apiFirstId = idOf(apiRows[0])

if (expectedIsDb) {
    def dbObj = vars.getObject(&apos;db_history_pos_rows&apos;)
    def dbRows = []
    if (dbObj instanceof List) dbRows = dbObj.collect { rowToMap(it) }
    else if (dbObj != null) dbRows = [rowToMap(dbObj)]
    dbRows = dbRows.findAll { it }
    if (!dbRows) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;数据库未返回汇总的已平仓仓位记录 | login=&apos; + login + &apos; | instanceid=&apos; + instanceId)
        return
    }
    dbFirstId = idOf(dbRows[0])
    for (a in apiRows) {
        def aid = idOf(a)
        def d = dbRows.find { idOf(it) == aid }
        if (d) {
            apiRow = a
            expectedRow = d
            matchedId = aid
            break
        }
    }
    if (!apiRow) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;接口和数据库数据记录没有匹配上订单号/仓位号 | apiFirst=&apos; + apiFirstId + &apos; | dbFirst=&apos; + dbFirstId + &apos; | apiIds=&apos; + apiRows.collect{ idOf(it) }.findAll{it}.join(&apos;,&apos;) + &apos; | dbIds=&apos; + dbRows.collect{ idOf(it) }.findAll{it}.join(&apos;,&apos;))
        return
    }
} else {
    expectedRow = new LinkedHashMap()
    def csvFields = &apos;shujuku,order_instanceid_val,order_login,close_time_utc_ms__gte,symbol,position_ticket,swap,fee,open_time_utc_ms,deal_ticket,source,login,volume,order_ticket,close_price,close_time_utc_ms,instance_id,action,commission,digits,open_price,profit,account_mode&apos;.split(&apos;,&apos;)
    csvFields.each { key -&gt;
        def val = vars.get(key)
        if (!blank(val)) expectedRow[key] = val
    }
    def csvId = idOf(expectedRow)
    for (a in apiRows) {
        if (idOf(a) == csvId) {
            apiRow = a
            matchedId = csvId
            break
        }
    }
    if (!apiRow) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&apos;CSV仓位号和接口响应返回仓位号没有匹配上 | csvId=&apos; + csvId + &apos; | apiFirst=&apos; + apiFirstId + &apos; | apiIds=&apos; + apiRows.collect{ idOf(it) }.findAll{it}.join(&apos;,&apos;))
        return
    }
}

def apiFields = apiRow.keySet().collect { String.valueOf(it) }
def detailsOk = []
def detailsFail = []
def detailsSkip = []
int comparedTotal = 0
int successCount = 0
int failCount = 0
int skipCount = 0
String compareIdText = matchedId ? &quot;订单号/仓位号=${matchedId} | &quot; : &apos;&apos;

apiFields.each { field -&gt;
    def apiVal = apiRow[field]
    if (disabled.contains(normKey(field))) {
        skipCount++
        def skippedExpectedKey = findKey(expectedRow, field)
        def skippedExpectedVal = skippedExpectedKey == null ? null : expectedRow[skippedExpectedKey]
        String skippedExpectedPrint = (skippedExpectedKey == null || blank(skippedExpectedVal)) ? (expectedIsDb ? &apos;&lt;empty&gt; 数据库查询无此字段数据或值为空&apos; : &apos;&lt;empty&gt; CSV未配置此字段或值为空&apos;) : rendered(field, skippedExpectedVal, !expectedIsDb, sourceName)
        String skippedExpectedField = skippedExpectedKey ?: field
        detailsSkip &lt;&lt; &quot;跳过 | ${compareIdText}字段=${field} | API=${rendered(field, apiVal, true, sourceName)} | ${sourceName}=${skippedExpectedPrint} | ${sourceName}字段=${skippedExpectedField} | 原因=字段在${disabledConfigName}中，未参与${sourceName}/API校验；虽然跳过但已打印${sourceName}查询/配置值&quot;
        return
    }

    def expectedKey = findKey(expectedRow, field)
    if (expectedKey == null || blank(expectedRow[expectedKey])) {
        skipCount++
        def marker = expectedIsDb ? &apos;&lt;empty&gt; 数据库查询无此字段数据&apos; : &apos;&lt;empty&gt; CSV未配置此字段或值为空&apos;
        detailsSkip &lt;&lt; &quot;跳过 | ${compareIdText}字段=${field} | API=${rendered(field, apiVal, true, sourceName)} | ${sourceName}=${marker} | 原因=${expectedIsDb ? &apos;数据库查询无此字段数据或值为空，无法对比&apos; : &apos;CSV未配置此字段或值为空，无法对比&apos;}&quot;
        return
    }

    comparedTotal++
    def expVal = expectedRow[expectedKey]
    if (expectedIsDb &amp;&amp; normKey(field) == &apos;swap&apos;) {
        BigDecimal apiNum = decimalValue(apiVal)
        BigDecimal dbNum = decimalValue(expVal)
        if (apiNum != null &amp;&amp; dbNum != null) {
            BigDecimal diff = dbNum.subtract(apiNum).abs()
            String apiPrint = rendered(field, apiVal, true, sourceName)
            String dbPrint = rendered(field, expVal, false, sourceName)
            if (dbNum.compareTo(BigDecimal.ZERO) == 0) {
                boolean zeroPass = apiNum.compareTo(BigDecimal.ZERO) == 0
                String zeroNote = zeroPass ? &apos;swap 基准DB值为0且API也是0，通过&apos; : &apos;swap 基准DB值为0，无法计算百分比且API不为0，失败&apos;
                def zeroLine = &quot;${zeroPass ? &apos;成功&apos; : &apos;失败&apos;} | ${compareIdText}字段=${field} | API=${apiPrint} | ${sourceName}=${dbPrint} | ${sourceName}字段=${expectedKey} | 差值=${decimalText(diff)} | 差值百分比=无法计算(DB基准值为0) | 计算公式=abs((DB=${decimalText(dbNum)} - API=${decimalText(apiNum)}) / DB=${decimalText(dbNum)}) * 100 | 备注=${zeroNote}&quot;
                if (zeroPass) { successCount++; detailsOk &lt;&lt; zeroLine } else { failCount++; detailsFail &lt;&lt; zeroLine }
                return
            }
            BigDecimal pct = diff.divide(dbNum.abs(), 10, java.math.RoundingMode.HALF_UP).multiply(new BigDecimal(&apos;100&apos;))
            boolean swapOk = pct.compareTo(new BigDecimal(&apos;10&apos;)) &lt;= 0
            String note = swapOk ? &apos;swap 误差小于10%，通过&apos; : &apos;swap 误差大于10%，失败&apos;
            String formula = &quot;abs((DB=${decimalText(dbNum)} - API=${decimalText(apiNum)}) / DB=${decimalText(dbNum)}) * 100 = ${percentText(pct)}&quot;
            def swapLine = &quot;${swapOk ? &apos;成功&apos; : &apos;失败&apos;} | ${compareIdText}字段=${field} | API=${apiPrint} | ${sourceName}=${dbPrint} | ${sourceName}字段=${expectedKey} | 差值=${decimalText(diff)} | 差值百分比=${percentText(pct)} | 计算公式=${formula} | 备注=${note}&quot;
            if (swapOk) { successCount++; detailsOk &lt;&lt; swapLine } else { failCount++; detailsFail &lt;&lt; swapLine }
            return
        }
    }
    if ([&apos;openprice&apos;, &apos;priceopen&apos;, &apos;closeprice&apos;, &apos;priceclose&apos;].contains(normKey(field))) {
        BigDecimal apiNum = decimalValue(apiVal)
        BigDecimal baseNum = decimalValue(expVal)
        if (apiNum != null &amp;&amp; baseNum != null) {
            BigDecimal diff = baseNum.subtract(apiNum).abs()
            String apiPrint = rendered(field, apiVal, true, sourceName)
            String basePrint = rendered(field, expVal, !expectedIsDb, sourceName)
            String priceFieldName = [&apos;openprice&apos;, &apos;priceopen&apos;].contains(normKey(field)) ? &apos;open_price&apos; : &apos;close_price&apos;
            if (baseNum.compareTo(BigDecimal.ZERO) == 0) {
                boolean zeroPass = apiNum.compareTo(BigDecimal.ZERO) == 0
                String zeroNote = zeroPass ? priceFieldName + &apos; 基准&apos; + sourceName + &apos;值为0且API也是0，通过&apos; : priceFieldName + &apos; 基准&apos; + sourceName + &apos;值为0，无法计算百分比且API不为0，失败&apos;
                def zeroLine = &quot;${zeroPass ? &apos;成功&apos; : &apos;失败&apos;} | ${compareIdText}字段=${field} | API=${apiPrint} | ${sourceName}=${basePrint} | ${sourceName}字段=${expectedKey} | 差值=${decimalText(diff)} | 差值百分比=无法计算(${sourceName}基准值为0) | 计算公式=abs((${sourceName}=${decimalText(baseNum)} - API=${decimalText(apiNum)}) / ${sourceName}=${decimalText(baseNum)}) * 100 | 备注=${zeroNote}&quot;
                if (zeroPass) { successCount++; detailsOk &lt;&lt; zeroLine } else { failCount++; detailsFail &lt;&lt; zeroLine }
                return
            }
            BigDecimal pct = diff.divide(baseNum.abs(), 10, java.math.RoundingMode.HALF_UP).multiply(new BigDecimal(&apos;100&apos;))
            boolean priceOk = pct.compareTo(new BigDecimal(&apos;2&apos;)) &lt;= 0
            String note = priceOk ? priceFieldName + &apos; 误差小于2%，通过&apos; : priceFieldName + &apos; 误差大于2%，失败&apos;
            String formula = &quot;abs((${sourceName}=${decimalText(baseNum)} - API=${decimalText(apiNum)}) / ${sourceName}=${decimalText(baseNum)}) * 100 = ${percentText(pct)}&quot;
            def priceLine = &quot;${priceOk ? &apos;成功&apos; : &apos;失败&apos;} | ${compareIdText}字段=${field} | API=${apiPrint} | ${sourceName}=${basePrint} | ${sourceName}字段=${expectedKey} | 差值=${decimalText(diff)} | 差值百分比=${percentText(pct)} | 计算公式=${formula} | 备注=${note}&quot;
            if (priceOk) { successCount++; detailsOk &lt;&lt; priceLine } else { failCount++; detailsFail &lt;&lt; priceLine }
            return
        }
    }
    boolean ok = sameValue(field, apiVal, expVal, expectedIsDb)
    def line = &quot;${ok ? &apos;成功&apos; : &apos;失败&apos;} | ${compareIdText}字段=${field} | API=${rendered(field, apiVal, true, sourceName)} | ${sourceName}=${rendered(field, expVal, !expectedIsDb, sourceName)} | ${sourceName}字段=${expectedKey}&quot;
    if (ok) {
        successCount++
        detailsOk &lt;&lt; line
    } else {
        failCount++
        detailsFail &lt;&lt; line
    }
}

def status = failCount == 0 ? &apos;PASS&apos; : &apos;FAIL&apos;
def report = []
report &lt;&lt; &apos;╔══════════════════════════════════════════════════════════════╗&apos;
report &lt;&lt; &apos;║  【汇总的已平仓仓位(进出交易) 对比结果】                    ║&apos;
report &lt;&lt; &apos;╚══════════════════════════════════════════════════════════════╝&apos;
report &lt;&lt; &quot;状态: ${status}&quot;
report &lt;&lt; &quot;数据来源: API vs ${sourceName}&quot;
report &lt;&lt; &quot;当前跳过字段配置: ${disabledConfigName}=[${disabledRaw}]&quot;
report &lt;&lt; &quot;instanceid=${instanceId} | login=${login} | 本次对比订单号/仓位号=${matchedId}&quot;
report &lt;&lt; &quot;接口返回记录数: ${apiRows.size()} | 接口首条订单号/仓位号: ${apiFirstId}&quot; + (expectedIsDb ? &quot; | DB首条订单号/仓位号: ${dbFirstId}&quot; : &apos;&apos;)
report &lt;&lt; &quot;接口对比字段总数量: ${apiFields.size()}&quot;
report &lt;&lt; &quot;实际参与对比字段数量: ${comparedTotal}&quot;
report &lt;&lt; &quot;成功字段数量: ${successCount}&quot;
report &lt;&lt; &quot;失败字段数量: ${failCount}&quot;
report &lt;&lt; &quot;跳过字段（未参与校验）数量: ${skipCount}&quot;
report &lt;&lt; &apos;时间字段规则: DB/API时API时间戳先按Asia/Shanghai展示，再减8小时取UTC格式后与DB时间比较；CSV/API时API和CSV时间只转换为Asia/Shanghai格式，不减8小时&apos;
report &lt;&lt; &apos;价格字段规则: open_price、close_price 按DB或CSV为基准计算差值百分比；误差大于2%计入失败字段，否则计入成功字段；字段跳过配置仍优先。&apos;
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【失败字段明细】&apos;
report.addAll(detailsFail ?: [&apos;无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【成功字段明细】&apos;
report.addAll(detailsOk ?: [&apos;无&apos;])
report &lt;&lt; &apos;&apos;
report &lt;&lt; &apos;【跳过字段明细（含跳过原因）】&apos;
report.addAll(detailsSkip ?: [&apos;无&apos;])

String finalReport = report.join(&apos;\n&apos;)
log.info(&apos;\n&apos; + finalReport)

def detail = new SampleResult()
detail.setSampleLabel(&apos;汇总的已平仓仓位字段对比结果&apos;)
detail.setSuccessful(failCount == 0)
detail.setResponseCode(failCount == 0 ? &apos;200&apos; : &apos;500&apos;)
detail.setResponseMessage(status)
detail.setResponseData(finalReport, &apos;UTF-8&apos;)
detail.setDataType(SampleResult.TEXT)
detail.setContentType(&apos;text/plain; charset=UTF-8&apos;)
prev.addSubResult(detail)

if (failCount &gt; 0) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(finalReport)
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
