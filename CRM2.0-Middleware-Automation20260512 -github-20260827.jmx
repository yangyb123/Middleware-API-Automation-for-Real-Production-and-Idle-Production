    BigDecimal dbid=number(value(direct,&apos;bid&apos;)), dask=number(value(direct,&apos;ask&apos;))
    if (dbid != null &amp;&amp; dask != null) {
        BigDecimal p=positive?dbid:dask; String q=String.valueOf(value(direct,&apos;__query_symbol&apos;) ?: from+to); String f=positive?&apos;bid&apos;:&apos;ask&apos;
        return [rate:p,path:q+&apos; &apos;+from+&apos;-&gt;&apos;+to+&apos;.&apos;+f+&apos;=&apos;+numText(p),detail:&apos;quote=&apos;+q+&apos; | field=&apos;+f+&apos; | bid=&apos;+numText(dbid)+&apos; | ask=&apos;+numText(dask)]
    }
    Map reverse = primaryQuote(primary,to,from); if (!(reverse instanceof Map)) reverse = symbolInfo(instance,to+from)
    BigDecimal rbid=number(value(reverse,&apos;bid&apos;)), rask=number(value(reverse,&apos;ask&apos;))
    if (rbid != null &amp;&amp; rask != null) {
        BigDecimal p=positive?rask:rbid
        if (p != BigDecimal.ZERO) { BigDecimal r=BigDecimal.ONE.divide(p,12,RoundingMode.HALF_UP); String q=String.valueOf(value(reverse,&apos;__query_symbol&apos;) ?: to+from); return [rate:r,path:&apos;1/&apos;+q+&apos;=&apos;+numText(r),detail:&apos;quote=&apos;+q+&apos; | inverse_price=&apos;+numText(p)+&apos; | bid=&apos;+numText(rbid)+&apos; | ask=&apos;+numText(rask)] }
    }
