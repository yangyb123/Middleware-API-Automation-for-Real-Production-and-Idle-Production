        }
        List&lt;Integer&gt; exactOrder = broad.findAll { int j -&gt; ak.order &amp;&amp; keyParts(dbRows[j]).order == ak.order }
        List&lt;Integer&gt; exactPosition = broad.findAll { int j -&gt; ak.position &amp;&amp; keyParts(dbRows[j]).position == ak.position }
        String expectedDbPosition = ak.position ?: ((ak.login &amp;&amp; ak.symbol &amp;&amp; ak.order) ? ak.login + &apos;:&apos; + ak.symbol + &apos;:&apos; + ak.order : &apos;&apos;)
        List&lt;Integer&gt; globalExactPosition = []
        List&lt;Integer&gt; globalExactOrder = []
        dbRows.eachWithIndex { Map dbRow, int idx -&gt;
            Map dk = keyParts(dbRow)
            if (expectedDbPosition &amp;&amp; dk.position == expectedDbPosition) globalExactPosition &lt;&lt; idx
            if (ak.order &amp;&amp; dk.order == ak.order) globalExactOrder &lt;&lt; idx
        }
        List&lt;Map&gt; filteredExactRows = filteredDbRows.findAll { Map filteredRow -&gt;
            Map fk = keyParts(filteredRow)
            (expectedDbPosition &amp;&amp; fk.position == expectedDbPosition) || (ak.order &amp;&amp; fk.order == ak.order &amp;&amp; fk.login == ak.login)
        }
        List&lt;Integer&gt; candidates = []
        String matchBasis
        if (ak.position &amp;&amp; exactPosition) { candidates = exactPosition; matchBasis = &apos;position_id&apos; }
        else if (ak.order &amp;&amp; exactOrder) { candidates = exactOrder; matchBasis = ak.position ? &apos;order_id_fallback(position_id未匹配)&apos; : &apos;order_id_fallback(position_id为空)&apos; }
        else if (broad.size() == 1) { candidates = broad; matchBasis = &apos;unique_instance_login_symbol_fallback&apos; }
        else { candidates = []; matchBasis = &apos;position_id-&gt;order_id-&gt;unique_instance_login_symbol均未取得唯一记录&apos; }
        if (candidates.size() != 1) {
            List&lt;Integer&gt; sameInstanceSymbol = []
            dbRows.eachWithIndex { Map dbRow, int idx -&gt;
                Map dk = keyParts(dbRow)
                if (ak.instance == dk.instance &amp;&amp; ak.symbol == dk.symbol) sameInstanceSymbol &lt;&lt; idx
            }
            List&lt;Integer&gt; diagnosticIndexes = broad ?: sameInstanceSymbol
            List&lt;String&gt; dbPositionCandidates = diagnosticIndexes.collect { int idx -&gt; dbPositionText(dbRows[idx]) }.unique()
            List&lt;String&gt; dbOrderCandidates = diagnosticIndexes.collect { int idx -&gt; dbOrderText(dbRows[idx]) }.unique()
            List&lt;String&gt; dbLoginCandidates = diagnosticIndexes.collect { int idx -&gt; keyParts(dbRows[idx]).login ?: &apos;&lt;empty&gt;&apos; }.unique()
            List&lt;String&gt; diagnosticRows = diagnosticIndexes.take(20).collect { int idx -&gt; dbCandidateText(dbRows[idx]) }
            List&lt;String&gt; globalPositionRows = globalExactPosition.take(20).collect { int idx -&gt; dbCandidateText(dbRows[idx]) }
            List&lt;String&gt; globalOrderRows = globalExactOrder.take(20).collect { int idx -&gt; dbCandidateText(dbRows[idx]) }
            List&lt;String&gt; filteredExactDiagnostics = filteredExactRows.take(20).collect { Map filteredRow -&gt;
                dbCandidateText(filteredRow) + &apos;, filter_match=&apos; + numText(lookup(filteredRow,&apos;_db_current_filter_match&apos;).value) + &apos;, filter_reason=&apos; + String.valueOf(lookup(filteredRow,&apos;_db_filter_reason&apos;).value ?: &apos;&lt;empty&gt;&apos;)
            }
            List&lt;String&gt; dbSample = dbRows.take(10).collect { Map row -&gt; dbCandidateText(row) }
            String candidateScope = broad ? &apos;same_instance_login_symbol&apos; : (sameInstanceSymbol ? &apos;same_instance_symbol_different_login&apos; : &apos;none&apos;)
            String dbDiagnosis = filteredExactRows ? &apos;DB原表存在该订单，但未通过当前未平仓过滤条件；具体原因见DB原表过滤诊断&apos; : &apos;本次JDBC原始候选结果中不存在该账户订单；API已返回该持仓，因此不是API无返回，也不是position_id展示格式问题。需继续确认报表库是否缺少/延迟同步该订单，或db_result_max_rows是否截断诊断记录&apos;
            String reason = !allDbRows ? &apos;JDBC结果集为空，数据库未返回任何请求账户记录&apos; : (!broad ? &apos;当前持仓DB结果中没有与接口相同的instance_id+login+symbol记录&apos; : &apos;数据库当前持仓候选记录无法唯一定位&apos;)
            failLines &lt;&lt; &apos; - [失败] | row=&apos; + (i+1) + &apos; | field=position_id | API数据状态=接口data已返回此持仓 | API.position_id=&apos; + (ak.position ?: &apos;&lt;empty&gt;&apos;) + &apos; | DB.position_id查询目标=&apos; + (expectedDbPosition ?: &apos;&lt;empty&gt;&apos;) + &apos; | DB当前持仓查询结果=&apos; + (globalPositionRows ?: [&apos;&lt;not-found-in-current-position-result&gt;&apos;]) + &apos; | DB原表过滤诊断=&apos; + (filteredExactDiagnostics ?: [&apos;&lt;no-raw-order-in-jdbc-result&gt;&apos;]) + &apos; | DB.position_id同账户品种候选=&apos; + (dbPositionCandidates ?: [&apos;&lt;no-corresponding-row&gt;&apos;]) + &apos; | API.order_id=&apos; + (ak.order ?: &apos;&lt;empty&gt;&apos;) + &apos; | DB.order_id当前持仓查询结果=&apos; + (globalOrderRows ?: [&apos;&lt;not-found-in-current-position-result&gt;&apos;]) + &apos; | API.login=&apos; + (ak.login ?: &apos;&lt;empty&gt;&apos;) + &apos; | DB.login候选=&apos; + (dbLoginCandidates ?: [&apos;&lt;no-corresponding-row&gt;&apos;]) + &apos; | SQL查询平台映射=[&apos; + (vars.get(&apos;competition_positions_db_platform_mappings&apos;) ?: &apos;&lt;empty&gt;&apos;) + &apos;] | CSV平台纠正=[&apos; + (vars.get(&apos;competition_positions_db_platform_corrections&apos;) ?: &apos;&lt;none&gt;&apos;) + &apos;] | candidate_scope=&apos; + candidateScope + &apos; | DB当前持仓相关记录=&apos; + (diagnosticRows ?: [&apos;&lt;none&gt;&apos;]) + &apos; | DB当前持仓样本=&apos; + (dbSample ?: [&apos;&lt;empty-result-set&gt;&apos;]) + &apos; | match_basis=&apos; + matchBasis + &apos; | 失败归属=数据库侧未取得可比较的当前持仓记录 | 原因=&apos; + reason + &apos; | 诊断结论=&apos; + dbDiagnosis + &apos; | JDBC原始候选总数=&apos; + allDbRows.size() + &apos; | DB当前持仓记录数=&apos; + dbRows.size() + &apos; | DB被过滤诊断记录数=&apos; + filteredDbRows.size()
            return
        }
        int j = candidates[0]
        usedDb &lt;&lt; j
        Map dbRow = dbRows[j]
        matchedDbRowByApiIndex[i] = dbRow
        fields.each { String f -&gt;
            def a = lookup(apiRow, f), d = lookup(dbRow, f)
            if (disabled.contains(&apos;*&apos;) || disabled.contains(norm(f))) { skipLines &lt;&lt; &apos; - [跳过] | row=&apos; + (i+1) + &apos; | field=&apos; + f + &apos; | API=&apos; + (a.exists ? numText(a.value) : &apos;&lt;field-missing&gt;&apos;) + &apos; | DB=&apos; + (d.exists ? numText(d.value) : &apos;&lt;field-missing&gt;&apos;) + &apos; | 备注=DB/API无条件跳过配置&apos;; return }
            if (!a.exists) { failLines &lt;&lt; &apos; - [失败] | row=&apos; + (i+1) + &apos; | field=&apos; + f + &apos; | API=&lt;field-missing&gt; | 原因=接口缺少必返字段&apos;; return }
            if (missingSkip.contains(&apos;*&apos;) || missingSkip.contains(norm(f))) { skipLines &lt;&lt; &apos; - [跳过] | row=&apos; + (i+1) + &apos; | field=&apos; + f + &apos; | API=&apos; + numText(a.value) + &apos; | DB=&apos; + (d.exists ? numText(d.value) : &apos;&lt;field-missing&gt;&apos;) + &apos; | 备注=已按competition_positions_db_missing_field_skip_fields配置跳过DB/API值比较；接口字段必返、类型和语义校验仍执行&apos;; return }
            if (!d.exists) {
                failLines &lt;&lt; &apos; - [失败] | row=&apos; + (i+1) + &apos; | field=&apos; + f + &apos; | API=&apos; + numText(a.value) + &apos; | DB=&lt;field-missing&gt; | 原因=数据库无此字段；字段不存在不等于字段值为空，可设置跳过&apos;
                return
            }
            if (f == &apos;open_notional_value_usd&apos; &amp;&amp; blank(d.value) &amp;&amp; !blank(a.value)) {
                skipLines &lt;&lt; &apos; - [跳过] | row=&apos; + (i+1) + &apos; | field=open_notional_value_usd | API=&apos; + numText(a.value) + &apos; | DB=&lt;empty&gt; | APIField=&apos; + a.key + &apos; | DBField=&apos; + d.key + &apos; | 备注=DB列存在但原始报表无名义价值投影，普通DB/API值比较跳过；该字段由NOTIONAL_CALC_PRINT_V4的calc_open_notional_value_usd与API_open_notional_value_usd独立计算和比对，不计入普通字段失败&apos;
                return
            }
            if (f == &apos;notional_status&apos;) {
                skipLines &lt;&lt; &apos; - [跳过] | data.row=&apos; + (i+1) + &apos; | field=notional_status | API=&apos; + numText(a.value) + &apos; | DB=&apos; + numText(d.value) + &apos; | 备注=普通DB/API固定投影比较跳过；该字段按线程组23口径由名义价值计算证据推导calc_cnotional_status后与API.notional_status独立比较&apos;
                return
            }
            def cr = compare(f, a.value, d.value, &apos;DB&apos;, tolerances, defaultTolerance)
            String line
            if (f == &apos;position_id&apos;) {
                String lifecycleText=String.valueOf(value(apiRow,&apos;position_lifecycle_id&apos;) ?: value(dbRow,&apos;position_lifecycle_id&apos;) ?: &apos;&lt;empty&gt;&apos;).trim()
                line=&apos;field=position_id | API=&apos;+cr.api+&apos; | DB=&apos;+cr.expected+&apos; | instanceid=&apos;+(ak.instance?:&apos;&lt;empty&gt;&apos;)+&apos; | login=&apos;+(ak.login?:&apos;&lt;empty&gt;&apos;)+&apos; | order_id=&apos;+(ak.order?:&apos;&lt;empty&gt;&apos;)+&apos; | position_id=&apos;+(ak.position?:&apos;&lt;empty&gt;&apos;)+&apos; | position_lifecycle_id=&apos;+lifecycleText+&apos; | symbol=&apos;+(ak.symbol?:&apos;&lt;empty&gt;&apos;)+&apos; | data.row=&apos;+(i+1)+&apos; | APIField=&apos;+a.key+&apos; | DBField=&apos;+d.key+&apos; | 差值=&apos;+cr.diff+&apos; | 相差百分比=&apos;+cr.percent+&apos; | 计算过程=&apos;+cr.formula+&apos; | 备注=&apos;+cr.note
            } else line = &apos;data.row=&apos; + (i+1) + &apos; | field=&apos; + f + &apos; | API=&apos; + cr.api + &apos; | DB=&apos; + cr.expected + &apos; | APIField=&apos; + a.key + &apos; | DBField=&apos; + d.key + &apos; | 差值=&apos; + cr.diff + &apos; | 相差百分比=&apos; + cr.percent + &apos; | 计算过程=&apos; + cr.formula + &apos; | 备注=&apos; + cr.note
            if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
        }
    }
    boolean paged = !blank(root.next_cursor) || !blank(vars.get(&apos;competition_positions_cursor&apos;))
    Map&lt;String,List&lt;Map&gt;&gt; errorsByAccount = [:].withDefault { [] }
    errors.each { Map err -&gt;
        String errorAccountKey = String.valueOf(err.instance_id ?: &apos;&apos;).trim() + &apos;|&apos; + idText(err.login)
        errorsByAccount[errorAccountKey] &lt;&lt; err
    }
    dbRows.eachWithIndex { Map row, int j -&gt;
        if (!usedDb.contains(j)) {
            Map dbKeyInfo = keyParts(row)
            String dbAccountKey = dbKeyInfo.instance + &apos;|&apos; + dbKeyInfo.login
            List&lt;Map&gt; accountErrors = errorsByAccount[dbAccountKey] ?: []
            String line = &apos; | DB键=&apos; + dbKeyInfo + &apos; | DB.position_id=&apos; + (dbKeyInfo.position ?: &apos;&lt;empty&gt;&apos;) + &apos; | DB记录=&apos; + row
            if (paged) skipLines &lt;&lt; &apos; - [跳过] | DB未匹配记录&apos; + line + &apos; | 备注=当前请求或响应存在cursor，仅校验本页&apos;
            else if (accountErrors) skipLines &lt;&lt; &apos; - [跳过] | 数据库记录未在API data中匹配&apos; + line + &apos; | API账户级errors=&apos; + JsonOutput.toJson(accountErrors) + &apos; | 备注=该实例账户在接口errors中返回错误，API data可能不完整；本条DB记录不再重复列为“接口缺少持仓”，但errors本身仍按competition_positions_allow_partial_errors决定整体通过或失败&apos;
            else failLines &lt;&lt; &apos; - [失败] | 数据库有当前未平仓持仓但API data未返回对应记录&apos; + line + &apos; | 备注=当前不是分页，且该实例账户不在接口errors中；可判定本次API data相对DB缺少该条持仓&apos;
        }
    }
    if (!apiRows &amp;&amp; !dbRows) okLines &lt;&lt; &apos; - [通过] | DB/API记录数均为0 | 备注=账户当前无未平仓持仓&apos;
} else {
    Map csvRow = vars.getObject(&apos;competition_positions_current_csv_row&apos;) instanceof Map ? new LinkedHashMap((Map)vars.getObject(&apos;competition_positions_current_csv_row&apos;)) : [:]
    String wantedPosition = String.valueOf(csvRow.position_id ?: &apos;&apos;).trim(), wantedOrder = idText(csvRow.order_id), wantedSymbol = String.valueOf(csvRow.symbol ?: &apos;&apos;).trim()
    List&lt;Map&gt; candidates = apiRows.findAll { Map row -&gt;
        if (wantedPosition &amp;&amp; wantedPosition != &apos;&lt;empty&gt;&apos;) return String.valueOf(row.position_id ?: &apos;&apos;) == wantedPosition
        if (wantedOrder) return idText(row.order_id) == wantedOrder &amp;&amp; (!wantedSymbol || String.valueOf(row.symbol ?: &apos;&apos;) == wantedSymbol)
        wantedSymbol ? String.valueOf(row.symbol ?: &apos;&apos;) == wantedSymbol : true
    }
    if (candidates.size() != 1) failLines &lt;&lt; &apos; - [失败] | CSV行=&apos; + vars.get(&apos;competition_positions_csv_line_no&apos;) + &apos; | position_id=&apos; + (wantedPosition ?: &apos;&lt;empty&gt;&apos;) + &apos; | order_id=&apos; + (wantedOrder ?: &apos;&lt;empty&gt;&apos;) + &apos; | symbol=&apos; + (wantedSymbol ?: &apos;&lt;empty&gt;&apos;) + &apos; | 原因=接口匹配记录数应为1，实际=&apos; + candidates.size()
    else fields.each { String f -&gt;
        Map apiRow = candidates[0]
        def a = lookup(apiRow, f)
        String raw = csvRow.containsKey(f) ? String.valueOf(csvRow[f] == null ? &apos;&apos; : csvRow[f]).trim() : null
        if (disabled.contains(&apos;*&apos;) || disabled.contains(norm(f))) { skipLines &lt;&lt; &apos; - [跳过] | field=&apos; + f + &apos; | API=&apos; + (a.exists ? numText(a.value) : &apos;&lt;field-missing&gt;&apos;) + &apos; | CSV=&apos; + (raw ?: &apos;&lt;empty&gt;&apos;) + &apos; | 备注=CSV/API跳过配置&apos;; return }
        if (!csvRow.containsKey(f)) { failLines &lt;&lt; &apos; - [失败] | field=&apos; + f + &apos; | 原因=CSV表头缺少V1字段&apos;; return }
        if (raw == &apos;&apos;) { skipLines &lt;&lt; &apos; - [跳过] | field=&apos; + f + &apos; | API=&apos; + (a.exists ? numText(a.value) : &apos;&lt;field-missing&gt;&apos;) + &apos; | CSV=&lt;empty&gt; | 备注=未填写期望值；断言空值请填写&lt;empty&gt;&apos;; return }
        if (!a.exists) { failLines &lt;&lt; &apos; - [失败] | field=&apos; + f + &apos; | API=&lt;field-missing&gt; | CSV=&apos; + raw; return }
        Object expected = raw in [&apos;&lt;empty&gt;&apos;,&apos;&lt;null&gt;&apos;] ? null : raw
        def cr = compare(f, a.value, expected, &apos;CSV&apos;, tolerances, defaultTolerance)
        String line = &apos;field=&apos; + f + &apos; | API=&apos; + cr.api + &apos; | CSV=&apos; + cr.expected + &apos; | 差值=&apos; + cr.diff + &apos; | 相差百分比=&apos; + cr.percent + &apos; | 计算过程=&apos; + cr.formula + &apos; | 备注=&apos; + cr.note
        if (cr.same) okLines &lt;&lt; &apos; - [通过] | &apos; + line else failLines &lt;&lt; &apos; - [失败] | &apos; + line
    }
}

// 辅助接口profit复算：保持线程组20的get_user_info/get_symbol_ex、买bid/卖ask及利润币种换算逻辑。
boolean auxEnabled = boolVar(&apos;competition_positions_aux_profit_calc_enabled&apos;, true)
int auxMax = intVar(&apos;competition_positions_aux_profit_calc_max_rows&apos;, 500, 0, 5000)
int connectTimeout = intVar(&apos;competition_positions_aux_http_connect_timeout_ms&apos;, 1500, 200, 30000)
int readTimeout = intVar(&apos;competition_positions_aux_http_read_timeout_ms&apos;, 5000, 500, 60000)
int retryCount = intVar(&apos;competition_positions_aux_retry_count&apos;, 3, 1, 10)
int retryDelay = intVar(&apos;competition_positions_aux_retry_delay_ms&apos;, 200, 0, 5000)
String auxDisabledRaw = vars.get(&apos;competition_positions_aux_profit_calc_disabled_compare_fields&apos;) ?: &apos;&apos;
Set&lt;String&gt; auxDisabled = setOf(auxDisabledRaw)
String auxToleranceRaw = vars.get(&apos;competition_positions_aux_profit_calc_field_tolerance_percent&apos;) ?: &apos;&apos;
Map&lt;String,BigDecimal&gt; auxTolerances = toleranceOf(auxToleranceRaw)
String host = (vars.get(&apos;middlewareip&apos;) ?: vars.get(&apos;CRM2.0middlewareip&apos;) ?: vars.get(&apos;ip&apos;) ?: &apos;&apos;).trim()
String port = (vars.get(&apos;port&apos;) ?: &apos;8080&apos;).trim()
String baseUrl = &apos;http://&apos; + host + (port ? &apos;:&apos; + port : &apos;&apos;)
Map&lt;String,String&gt; currencyCache = [:]
Map&lt;String,Map&gt; symbolCache = [:]
def enc = { Object v -&gt; java.net.URLEncoder.encode(String.valueOf(v ?: &apos;&apos;), &apos;UTF-8&apos;) }
def rowsOf = { Object json -&gt;
    if (json instanceof Map &amp;&amp; json.data instanceof List) return json.data.findAll { it instanceof Map }.collect { new LinkedHashMap((Map)it) }
    if (json instanceof Map &amp;&amp; json.data instanceof Map &amp;&amp; json.data.items instanceof List) return json.data.items.findAll { it instanceof Map }.collect { new LinkedHashMap((Map)it) }
    if (json instanceof Map &amp;&amp; json.data instanceof Map) return [new LinkedHashMap((Map)json.data)]
    if (json instanceof Map &amp;&amp; json.items instanceof List) return json.items.findAll { it instanceof Map }.collect { new LinkedHashMap((Map)it) }
    []
}
def getJson = { String path -&gt;
    if (!host) throw new IllegalStateException(&apos;middlewareip/CRM2.0middlewareip/ip为空&apos;)
    for (int attempt=1; attempt&lt;=retryCount; attempt++) {
        java.net.HttpURLConnection conn = null
        try {
            conn = (java.net.HttpURLConnection)new java.net.URL(baseUrl + path).openConnection()
            conn.setRequestMethod(&apos;GET&apos;); conn.setConnectTimeout(connectTimeout); conn.setReadTimeout(readTimeout); conn.setRequestProperty(&apos;Accept&apos;,&apos;application/json&apos;)
            int http = conn.getResponseCode()
            java.io.InputStream stream = http &gt;= 200 &amp;&amp; http &lt; 300 ? conn.getInputStream() : conn.getErrorStream()
            String text = stream == null ? &apos;&apos; : stream.getText(&apos;UTF-8&apos;)
            Object json = text ? new JsonSlurper().parseText(text) : [:]
            String code = json instanceof Map ? String.valueOf(json.code ?: &apos;&apos;) : &apos;&apos;
            String msg = json instanceof Map ? String.valueOf(json.msg ?: json.message ?: &apos;&apos;) : &apos;&apos;
            if (code == &apos;4002&apos; || msg.toLowerCase().contains(&apos;still in flight&apos;)) {
                if (attempt &lt; retryCount) { if (retryDelay &gt; 0) Thread.sleep(retryDelay); continue }
                throw new IllegalStateException(&apos;连续返回4002/in flight，重试&apos; + retryCount + &apos;次仍失败: &apos; + text)
            }
            if (http &lt; 200 || http &gt;= 300) throw new IllegalStateException(&apos;http=&apos; + http + &apos;, body=&apos; + text)
            return json
        } finally { try { conn?.disconnect() } catch (ignored) {} }
    }
    [:]
}
def accountCurrency = { String instance, Object login -&gt;
    String key = instance + &apos;|&apos; + idText(login)
    if (currencyCache.containsKey(key)) return currencyCache[key]
    List&lt;Map&gt; rows = rowsOf(getJson(&apos;/crm20/get_user_info?instanceid=&apos; + enc(instance) + &apos;&amp;login=&apos; + enc(idText(login))))
    Map row = rows ? rows[0] : [:]
    Object cur = value(row,&apos;currency&apos;)
    if (blank(cur) &amp;&amp; row.Group instanceof Map) cur = row.Group.Currency
    if (blank(cur) &amp;&amp; row.group instanceof Map) cur = row.group.currency ?: row.group.Currency
    String result = blank(cur) ? &apos;&apos; : String.valueOf(cur).trim().toUpperCase()
    currencyCache[key] = result
    result
}
def symbolInfo = { String instance, String symbol -&gt;
    String key = instance + &apos;|&apos; + symbol.toUpperCase()
    if (symbolCache.containsKey(key)) return symbolCache[key]
    Map result = [:]
    try {
